# Only curated source/configuration/documentation enters this local repository.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/docs/
!/docs/**
/docs/local-history/
!/LICENSES/
!/LICENSES/**
!/configs/
!/configs/**
!/patches/
/patches/*
!/patches/kernel/
!/patches/kernel/**
!/patches/userspace/
!/patches/userspace/**
!/tools/
/tools/*
!/tools/release/
!/tools/release/**
!/tools/project/
!/tools/project/**
!/tools/add-boot-bluetooth-firmware.py
!/tools/input/
!/tools/input/**
!/tools/power/
!/tools/power/*.c
!/tools/power/*.h
!/tools/sensors/
!/tools/sensors/**
!/tools/display-scaling/
/tools/display-scaling/*
!/tools/display-scaling/build.sh
!/tools/display-scaling/build-modesetting.sh
!/tools/display-scaling/gnome-control-center
!/tools/display-scaling/limited-scales.c
!/tools/display-scaling/*.patch
!/tools/stability/
/tools/stability/*
!/tools/stability/kernel-evidence.py
!/tools/stability/j716f-kernel-evidence.service
!/tools/stability/60-j716f-*.conf
!/tools/stability/test_kernel_evidence.py
!/tools/fingerprint-system/
/tools/fingerprint-system/*
!/tools/fingerprint-system/build-libfprint.sh
!/tools/fingerprint-system/j716f-fingerprintctl.c
!/tools/fingerprint-system/units/
!/tools/fingerprint-system/units/**
!/mkbootimg-aosp/
!/mkbootimg-aosp/**
!/toolchain/
/toolchain/*
!/toolchain/env.sh
!/verify-bootimg.py

# Generated/binary files and credentials remain outside Git even in allowed dirs.
**/.git/
**/__pycache__/
*.pyc
*.pyo
*.o
*.a
*.ko
*.so
*.so.*
*.img
*.bin
*.cpio
*.cpio.gz
*.tar
*.tar.gz
*.tar.xz
*.zip
*.partial
*.log
*.pem
*.key
*.pub
id_rsa
id_ed25519
ssh_host_*
core.[0-9]*
*.swp
*~

# Track the clean reconstructed J716F kernel source tree.
!/kernel/
!/kernel/linux-6.15.11/
!/kernel/linux-6.15.11/**
