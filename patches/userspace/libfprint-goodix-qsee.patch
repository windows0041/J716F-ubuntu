+  GOODIX_J716F_TA_DEAD = 1049,
+  GOODIX_J716F_UNTRUSTED_ENROLL = 1057,
+  GOODIX_J716F_MATCH_FAIL_AND_RETRY = 1064,
+  GOODIX_J716F_TOO_FAST = 1094,
+  GOODIX_J716F_IMAGER_DIRTY_1101 = 1101,
