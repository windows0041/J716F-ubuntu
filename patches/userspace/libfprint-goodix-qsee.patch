+
+enum goodix_j716f_status {
+  GOODIX_J716F_SUCCESS = 0,
+  GOODIX_J716F_ACQUIRED_PARTIAL = 1011,
+  GOODIX_J716F_IMAGER_DIRTY_1012 = 1012,
