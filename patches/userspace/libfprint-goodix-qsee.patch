diff --git a/libfprint/drivers/goodixj716f/README.md b/libfprint/drivers/goodixj716f/README.md
new file mode 100644
index 0000000..2b972cb
--- /dev/null
+++ b/libfprint/drivers/goodixj716f/README.md
@@ -0,0 +1,31 @@
+# Lenovo J716F Goodix QSEE profile 2
+
+This driver is a separate profile for this tablet's `goodixfp` application,
+`GF_CHIP_3626ZS1`, version `V00.04.05.01` / `Milan_v_3.02.00.26`.
+It derives from `goodixqsee` in wrobelda/libfprint commit
+430e24e538ba137b6edcfe2e1b3b8cc29c66fa6a. The original profile is retained.
+
+The transport and codec values were checked against the tablet's stock HAL
+and a restricted client on Linux 6.15.11 #524. That client completed enrolment,
+save/enumerate, known-finger match with AUTH_FINISH, and a separate non-match.
+The libfprint integration subsequently listed the stored left-index record,
+returned a match for that finger and a non-match for a separate unregistered
+finger through Ubuntu fprintd. A user-authorized GDM lock-screen trial also
+returned verify-match and unlocked the session, confirmed by the user.
+After a separately authorized reboot, both persistent services loaded, the
+record remained, and a second GDM fingerprint unlock succeeded and was
+confirmed by the user. On the subsequent #525 keyboard-wake kernel, a
+controlled suspend/resume trial also returned GDM verify-match and unlocked
+the session. Libfprint enrol/delete still need controlled live validation.
+
+This profile uses a 96-byte common body, INIT344/FINISH100, PRE104, ENROLL176,
+GROUP100, ENUM180, SAVE108, REMOVE188, AUTH120 and AUTH_FINISH120. IRQ327584
+uses mask96/op100, group0x4fcc0/finger0x4fcc4/remaining-u16-0x4fcc8, controls
+0x4fd65/0x4fd94/0x4ff9c. AUTH_FINISH uses ordinary LE field copies.
+
+Enrolment uses the explicit reference challenge-only token accepted in the
+isolated tablet test, with normal Linux/fprintd enrolment authorization. It
+is not a Gatekeeper-signed HAT implementation. Matching remains in the TA;
+only matching IDs are accepted against the caller's enrolled-print gallery.
+No image/template dump paths are present. The machine-wide supplicant owns
+the sealed state; this driver opens only the normal TEE and sensor devices.
diff --git a/libfprint/drivers/goodixj716f/goodix-j716f-proto.c b/libfprint/drivers/goodixj716f/goodix-j716f-proto.c
new file mode 100644
index 0000000..9f16dfc
--- /dev/null
+++ b/libfprint/drivers/goodixj716f/goodix-j716f-proto.c
@@ -0,0 +1,106 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#include "goodix-j716f-proto.h"
+
+#include <string.h>
+
+#define IRQ_MASK 96u
+#define IRQ_OPERATION 100u
+#define IRQ_ENROLL_GROUP 0x4fcc0u
+#define IRQ_ENROLL_FINGER 0x4fcc4u
+#define IRQ_ENROLL_REMAIN 0x4fcc8u
+#define IRQ_CTRL_MODE 327013u
+#define IRQ_CTRL_SIZE 327060u
+#define IRQ_CTRL_ARM 327580u
+
+static uint32_t
+get32 (const uint8_t *p)
+{
+  uint32_t value;
+  memcpy (&value, p, sizeof (value));
+  return value;
+}
+
+static void
+put32 (uint8_t *p, uint32_t value)
+{
+  memcpy (p, &value, sizeof (value));
+}
+
+uint32_t
+goodix_j716f_parse_response_status (const uint8_t response[GOODIX_J716F_RESPONSE_SIZE])
+{
+  if (get32 (response + 4))
+    return GOODIX_J716F_TA_DEAD;
+
+  return get32 (response);
+}
+
+size_t
+goodix_j716f_parse_enumerate (const uint8_t payload[GOODIX_J716F_ENUMERATE_SIZE],
+                       struct goodix_j716f_finger out[GOODIX_J716F_ENUMERATE_MAX],
+                       bool *count_mismatch)
+{
+  uint32_t declared = get32 (payload + 96);
+  size_t i, count = 0;
+
+  for (i = 0; i < GOODIX_J716F_ENUMERATE_MAX; i++)
+    {
+      uint32_t finger = get32 (payload + 140 + 4 * i);
+      if (!finger)
+        continue;
+      out[count].group_id = get32 (payload + 100 + 4 * i);
+      out[count].finger_id = finger;
+      count++;
+    }
+  if (count_mismatch)
+    *count_mismatch = declared != count;
+  return count;
+}
+
+bool
+goodix_j716f_prepare_irq (uint8_t payload[GOODIX_J716F_IRQ_SIZE])
+{
+  put32 (payload + IRQ_CTRL_MODE, 0x02000000);
+  put32 (payload + IRQ_CTRL_SIZE, 512);
+  put32 (payload + IRQ_CTRL_ARM, 1);
+  return true;
+}
+
+bool
+goodix_j716f_parse_irq (const uint8_t payload[GOODIX_J716F_IRQ_SIZE],
+                 struct goodix_j716f_irq_result *out)
+{
+  if (!payload || !out)
+    return false;
+  out->status = get32 (payload + 12);
+  out->mask = get32 (payload + IRQ_MASK);
+  out->operation = get32 (payload + IRQ_OPERATION);
+  out->group_id = get32 (payload + IRQ_ENROLL_GROUP);
+  out->finger_id = get32 (payload + IRQ_ENROLL_FINGER);
+  out->samples_remaining = payload[IRQ_ENROLL_REMAIN] | (uint32_t) payload[IRQ_ENROLL_REMAIN + 1] << 8;
+  return true;
+}
+
+bool
+goodix_j716f_build_enroll (uint8_t *payload, size_t size, uint32_t group_id,
+                    const uint8_t hat[GOODIX_J716F_HAT_SIZE])
+{
+  if (!payload || !hat || size != 176)
+    return false;
+  memset (payload, 0, 176);
+  put32 (payload + 96, group_id);
+  memcpy (payload + 106, hat, GOODIX_J716F_HAT_SIZE);
+  return true;
+}
+
+bool
+goodix_j716f_build_finger_command (uint8_t *payload, size_t size,
+                            uint32_t group_id, uint32_t finger_id)
+{
+  if (!payload || (size != 108 && size != 188))
+    return false;
+  memset (payload, 0, size);
+  put32 (payload + 96, group_id);
+  put32 (payload + 100, finger_id);
+  return true;
+}
