+                      struct goodix_j716f_irq_result *out);
+bool goodix_j716f_build_enroll (uint8_t *payload, size_t size, uint32_t group_id,
+                         const uint8_t hat[GOODIX_J716F_HAT_SIZE]);
+bool goodix_j716f_build_finger_command (uint8_t *payload, size_t size,
