+#pragma once
+
+#include "fpi-device.h"
+#include "goodix-j716f-sensor.h"
+#include "goodix-j716f-transport.h"
+#include "goodix-j716f-token.h"
+
+G_DECLARE_FINAL_TYPE (FpiDeviceGoodixJ716f, fpi_device_goodixj716f,
+                      FPI, DEVICE_GOODIXJ716F, FpDevice)
+
+struct _FpiDeviceGoodixJ716f
+{
+  FpDevice parent;
+  struct goodix_j716f_sensor sensor;
+  struct goodix_j716f_qsee qsee;
