+static const struct snd_soc_dapm_route es7210_dapm_routes[] = {
+	{ "ADC1", NULL, "MIC1" },
+	{ "ADC2", NULL, "MIC2" },
+	{ "ADC3", NULL, "MIC3" },
+	{ "ADC4", NULL, "MIC4" },
+	/*
