+static inline struct gc5035 *to_gc5035(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct gc5035, sd);
+}
+
+static int gc5035_set_page(struct gc5035 *gc5035, u8 page)
+{
+	return cci_write(gc5035->regmap, GC5035_REG_PAGE_SELECT, page, NULL);
+}
+
+static int gc5035_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct gc5035 *gc5035 = to_gc5035(sd);
+	int ret;
+
+	ret = regulator_enable(gc5035->supplies[0].consumer);
+	if (ret) {
+		dev_err(dev, "failed to enable dovdd: %d\n", ret);
+		return ret;
+	}
+
+	fsleep(GC5035_IOVDD_DELAY_US);
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(gc5035_supply_name) - 1,
+				    &gc5035->supplies[1]);
+	if (ret) {
+		dev_err(dev, "failed to enable regulators: %d\n", ret);
+		goto err_dovdd;
+	}
+
+	ret = clk_prepare_enable(gc5035->xclk);
+	if (ret) {
+		dev_err(dev, "failed to enable clock: %d\n", ret);
+		goto err_regulators;
+	}
+
+	gpiod_set_value_cansleep(gc5035->powerdown_gpio, 0);
+	gpiod_set_value_cansleep(gc5035->reset_gpio, 0);
+
+	fsleep(GC5035_RESET_DELAY_US);
+
+	return 0;
+
+err_regulators:
+	regulator_bulk_disable(ARRAY_SIZE(gc5035_supply_name) - 1,
+			       &gc5035->supplies[1]);
+err_dovdd:
+	regulator_disable(gc5035->supplies[0].consumer);
+
+	return ret;
+}
+
+static int gc5035_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct gc5035 *gc5035 = to_gc5035(sd);
+
+	fsleep(GC5035_STOP_DELAY_US);
+
+	gpiod_set_value_cansleep(gc5035->powerdown_gpio, 1);
+	gpiod_set_value_cansleep(gc5035->reset_gpio, 1);
+	clk_disable_unprepare(gc5035->xclk);
+	regulator_bulk_disable(ARRAY_SIZE(gc5035_supply_name) - 1,
+			       &gc5035->supplies[1]);
+	regulator_disable(gc5035->supplies[0].consumer);
+
+	return 0;
+}
+
+static int gc5035_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *sd_state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index > 0)
+		return -EINVAL;
+
+	code->code = GC5035_MBUS_CODE;
+
+	return 0;
+}
+
+static int gc5035_enum_frame_size(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *sd_state,
+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	struct gc5035 *gc5035 = to_gc5035(sd);
+
+	if (fse->code != GC5035_MBUS_CODE)
+		return -EINVAL;
+
+	switch (fse->index) {
+	case 0:
+		/* Without binning, the output size is the crop size. */
+		fse->min_width = GC5035_MIN_WIDTH;
+		fse->max_width = GC5035_AREA_WIDTH;
+		fse->min_height = GC5035_MIN_HEIGHT;
+		fse->max_height = GC5035_AREA_HEIGHT;
+		break;
+	case 1:
+		/* 2x2 binning of the default crop rectangle. */
+		if (!gc5035->binning)
+			return -EINVAL;
+		fse->min_width = GC5035_WIDTH / 2;
+		fse->max_width = GC5035_WIDTH / 2;
+		fse->min_height = GC5035_HEIGHT / 2;
+		fse->max_height = GC5035_HEIGHT / 2;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+/* Binning is the only case where the output is smaller than the crop. */
+static bool gc5035_is_binned(const struct v4l2_rect *crop,
+			     const struct v4l2_mbus_framefmt *format)
+{
+	return format->width < crop->width;
+}
+
+/*
+ * Update the controls that depend on the output size and on binning. Called
+ * with the state lock held, which is also the control handler lock.
+ */
+static int gc5035_update_ctrls(struct gc5035 *gc5035,
+			       const struct v4l2_rect *crop,
+			       const struct v4l2_mbus_framefmt *format)
+{
+	bool binned = gc5035_is_binned(crop, format);
+	s64 vblank_min, vblank_max, exposure_max;
+	u32 hts;
+	int ret;
+
+	ret = __v4l2_ctrl_s_ctrl(gc5035->link_freq,
+				 binned ? GC5035_LINK_FREQ_BIN_INDEX :
+					  GC5035_LINK_FREQ_FULL_INDEX);
+	if (ret)
+		return ret;
+
+	ret = __v4l2_ctrl_s_ctrl_int64(gc5035->pixel_rate,
+				       binned ? GC5035_PIXEL_RATE_BIN :
+						GC5035_PIXEL_RATE);
+	if (ret)
+		return ret;
+
+	hts = binned ? GC5035_HTS_BIN : GC5035_HTS;
+	ret = __v4l2_ctrl_modify_range(gc5035->hblank, hts - format->width,
+				       hts - format->width, 1,
+				       hts - format->width);
+	if (ret)
+		return ret;
+
+	vblank_min = binned ? GC5035_VTS_MIN_BIN - format->height :
+			      GC5035_VBLANK_MIN;
+	vblank_max = vblank_min +
+		     round_down(GC5035_VTS_MAX - format->height - vblank_min,
+				GC5035_VBLANK_STEP);
+	/*
+	 * As in ov01a10, setting the format or the crop rectangle resets the
+	 * vertical blanking.
+	 */
+	ret = __v4l2_ctrl_modify_range(gc5035->vblank, vblank_min, vblank_max,
+				       GC5035_VBLANK_STEP, vblank_min);
+	if (ret)
+		return ret;
+
+	ret = __v4l2_ctrl_s_ctrl(gc5035->vblank, vblank_min);
+	if (ret)
+		return ret;
+
+	exposure_max = format->height + gc5035->vblank->val -
+		       GC5035_EXP_MARGIN;
+
+	return __v4l2_ctrl_modify_range(gc5035->exposure, GC5035_EXP_MIN,
+					exposure_max, GC5035_EXP_STEP,
+					min_t(s64, GC5035_EXP_DEF,
+					      exposure_max));
+}
+
+static void gc5035_fill_format(struct v4l2_mbus_framefmt *fmt,
+			       const struct v4l2_rect *crop, unsigned int bin)
+{
+	fmt->width = crop->width / bin;
+	fmt->height = crop->height / bin;
+	fmt->code = GC5035_MBUS_CODE;
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_RAW;
+	fmt->ycbcr_enc = V4L2_MAP_YCBCR_ENC_DEFAULT(fmt->colorspace);
+	fmt->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	fmt->xfer_func = V4L2_XFER_FUNC_NONE;
+}
+
+static int gc5035_get_selection(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *state,
+				struct v4l2_subdev_selection *sel)
+{
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+		sel->r = *v4l2_subdev_state_get_crop(state, 0);
+		break;
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+		sel->r.top = GC5035_CROP_TOP;
+		sel->r.left = GC5035_CROP_LEFT;
+		sel->r.width = GC5035_WIDTH;
+		sel->r.height = GC5035_HEIGHT;
+		break;
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+		sel->r.top = 0;
+		sel->r.left = 0;
+		sel->r.width = GC5035_AREA_WIDTH;
+		sel->r.height = GC5035_AREA_HEIGHT;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static int gc5035_set_selection(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *state,
+				struct v4l2_subdev_selection *sel)
+{
+	struct gc5035 *gc5035 = to_gc5035(sd);
+	struct v4l2_mbus_framefmt *format;
+	struct v4l2_rect rect;
+
+	if (sel->target != V4L2_SEL_TGT_CROP)
+		return -EINVAL;
+
+	if (sel->which == V4L2_SUBDEV_FORMAT_ACTIVE &&
+	    v4l2_subdev_is_streaming(sd))
+		return -EBUSY;
+
+	/*
+	 * Even offsets keep the GRBG order. The sizes are multiples of 4: the
+	 * sensor rounds the frame length to a multiple of 4 lines.
+	 */
+	rect.left = ALIGN_DOWN(clamp(sel->r.left, 0,
+				     GC5035_AREA_WIDTH - GC5035_MIN_WIDTH), 2);
+	rect.top = ALIGN_DOWN(clamp(sel->r.top, 0,
+				    GC5035_AREA_HEIGHT - GC5035_MIN_HEIGHT), 2);
+	rect.width = ALIGN_DOWN(clamp_t(u32, sel->r.width, GC5035_MIN_WIDTH,
+					GC5035_AREA_WIDTH - rect.left), 4);
+	rect.height = ALIGN_DOWN(clamp_t(u32, sel->r.height, GC5035_MIN_HEIGHT,
+					 GC5035_AREA_HEIGHT - rect.top), 4);
+
+	*v4l2_subdev_state_get_crop(state, 0) = rect;
+	sel->r = rect;
+
+	/* A new crop rectangle disables binning: the output is its size. */
+	format = v4l2_subdev_state_get_format(state, 0);
+	gc5035_fill_format(format, &rect, 1);
+
+	if (sel->which == V4L2_SUBDEV_FORMAT_ACTIVE)
+		return gc5035_update_ctrls(gc5035, &rect, format);
+
+	return 0;
+}
+
+/*
+ * Half the size of the default crop rectangle selects 2x2 binning and sets
+ * the default crop rectangle back, unless the crop rectangle already has
+ * that size: the size alone selects the binned mode, with the full field of
+ * view, and a crop rectangle of that size set first stays unbinned.
+ * Otherwise the output size is the size of the crop rectangle: a new width
+ * or height centres the crop rectangle on the default crop rectangle along
+ * that axis, within the area, for userspace that does not set the crop
+ * rectangle first. The default size gives the default rectangle back.
+ */
+static int gc5035_set_fmt(struct v4l2_subdev *sd,
+			  struct v4l2_subdev_state *state,
+			  struct v4l2_subdev_format *fmt)
+{
+	static const struct v4l2_rect crop_default = {
+		.left = GC5035_CROP_LEFT,
+		.top = GC5035_CROP_TOP,
+		.width = GC5035_WIDTH,
+		.height = GC5035_HEIGHT,
+	};
+	struct gc5035 *gc5035 = to_gc5035(sd);
+	struct v4l2_mbus_framefmt *format;
+	struct v4l2_rect *crop;
+	u32 width, height;
+	unsigned int bin;
+	int pos;
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_ACTIVE &&
+	    v4l2_subdev_is_streaming(sd))
+		return -EBUSY;
+
+	width = ALIGN_DOWN(clamp_t(u32, fmt->format.width, GC5035_MIN_WIDTH,
+				   GC5035_AREA_WIDTH), 4);
+	height = ALIGN_DOWN(clamp_t(u32, fmt->format.height, GC5035_MIN_HEIGHT,
+				    GC5035_AREA_HEIGHT), 4);
+
+	crop = v4l2_subdev_state_get_crop(state, 0);
+	bin = gc5035->binning && width == GC5035_WIDTH / 2 &&
+	      height == GC5035_HEIGHT / 2 &&
+	      (width != crop->width || height != crop->height) ? 2 : 1;
+	if (bin == 2)
+		*crop = crop_default;
+	if (bin == 1 && width != crop->width) {
+		pos = GC5035_CROP_LEFT + (GC5035_WIDTH - (int)width) / 2;
+		pos = clamp(pos, 0, GC5035_AREA_WIDTH - (int)width);
+		crop->left = ALIGN_DOWN(pos, 2);
+		crop->width = width;
+	}
+	if (bin == 1 && height != crop->height) {
+		pos = GC5035_CROP_TOP + (GC5035_HEIGHT - (int)height) / 2;
+		pos = clamp(pos, 0, GC5035_AREA_HEIGHT - (int)height);
+		crop->top = ALIGN_DOWN(pos, 2);
+		crop->height = height;
+	}
+
+	format = v4l2_subdev_state_get_format(state, 0);
+	gc5035_fill_format(format, crop, bin);
+	fmt->format = *format;
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_ACTIVE)
+		return gc5035_update_ctrls(gc5035, crop, format);
+
+	return 0;
+}
+
+static int gc5035_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state)
+{
+	struct v4l2_rect *crop = v4l2_subdev_state_get_crop(state, 0);
+
+	crop->left = GC5035_CROP_LEFT;
+	crop->top = GC5035_CROP_TOP;
+	crop->width = GC5035_WIDTH;
+	crop->height = GC5035_HEIGHT;
+
+	gc5035_fill_format(v4l2_subdev_state_get_format(state, 0), crop, 1);
+
+	return 0;
+}
+
+static int gc5035_get_frame_desc(struct v4l2_subdev *sd, unsigned int pad,
+				 struct v4l2_mbus_frame_desc *fd)
+{
+	fd->type = V4L2_MBUS_FRAME_DESC_TYPE_CSI2;
+	fd->num_entries = 1;
+	fd->entry[0].pixelcode = GC5035_MBUS_CODE;
+	fd->entry[0].stream = 0;
+	fd->entry[0].bus.csi2.vc = 0;
+	fd->entry[0].bus.csi2.dt = MIPI_CSI2_DT_RAW10;
+
+	return 0;
+}
+
+static int gc5035_test_pattern(struct gc5035 *gc5035, u32 pattern)
+{
+	int ret;
+
+	ret = gc5035_set_page(gc5035, GC5035_PAGE_1);
+	if (ret)
+		return ret;
+
+	ret = cci_write(gc5035->regmap, GC5035_REG_TEST_PATTERN,
+			pattern ? GC5035_TEST_PATTERN_ON :
+				  GC5035_TEST_PATTERN_OFF, NULL);
+
+	/* Back to page 0 even on error, the other controls expect it. */
+	return gc5035_set_page(gc5035, GC5035_PAGE_0) ?: ret;
+}
+
+static int gc5035_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct gc5035 *gc5035 =
+		container_of(ctrl->handler, struct gc5035, ctrls);
+	const struct v4l2_mbus_framefmt *format;
+	struct v4l2_subdev_state *state;
+	s64 exposure_max;
+	int ret;
+
+	state = v4l2_subdev_get_locked_active_state(&gc5035->sd);
+	format = v4l2_subdev_state_get_format(state, 0);
+
+	if (ctrl->id == V4L2_CID_VBLANK) {
+		exposure_max = format->height + ctrl->val -
+			       GC5035_EXP_MARGIN;
+		ret = __v4l2_ctrl_modify_range(gc5035->exposure,
+					       GC5035_EXP_MIN, exposure_max,
+					       GC5035_EXP_STEP,
+					       min_t(s64, GC5035_EXP_DEF,
+						     exposure_max));
+		if (ret)
+			return ret;
+	}
+
+	if (!pm_runtime_get_if_active(gc5035->dev))
+		return 0;
+
+	ret = gc5035_set_page(gc5035, GC5035_PAGE_0);
+	if (ret)
+		goto out;
+
+	switch (ctrl->id) {
+	case V4L2_CID_EXPOSURE:
+		ret = cci_write(gc5035->regmap, GC5035_REG_EXPOSURE,
+				ctrl->val, NULL);
+		break;
+	case V4L2_CID_ANALOGUE_GAIN:
+		ret = cci_write(gc5035->regmap, GC5035_REG_ANALOGUE_GAIN,
+				gc5035_again_code[ctrl->val], NULL);
+		break;
+	case V4L2_CID_VBLANK:
+		ret = cci_write(gc5035->regmap, GC5035_REG_FRAME_LENGTH,
+				format->height + ctrl->val, NULL);
+		break;
+	case V4L2_CID_TEST_PATTERN:
+		ret = gc5035_test_pattern(gc5035, ctrl->val);
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+
+out:
+	pm_runtime_put_autosuspend(gc5035->dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops gc5035_ctrl_ops = {
+	.s_ctrl = gc5035_set_ctrl,
+};
+
+/* Only ever called from probe, with the sensor powered up. */
+static int gc5035_identify_module(struct gc5035 *gc5035)
+{
+	u64 val;
+	int ret;
+
+	ret = cci_read(gc5035->regmap, GC5035_REG_CHIP_ID, &val, NULL);
+	if (ret) {
+		dev_err(gc5035->dev, "gc5035: chip-ID read failed: %d\n", ret);
+		return ret;
+	}
+
+	dev_info(gc5035->dev, "gc5035: chip-ID read 0x%llx (expected 0x%x)\n",
+		 val, GC5035_CHIP_ID);
+
+	if (val != GC5035_CHIP_ID)
+		return dev_err_probe(gc5035->dev, -ENXIO,
+				     "chip id mismatch: %x != %llx\n",
+				     GC5035_CHIP_ID, val);
+
+	return 0;
+}
+
+static int gc5035_write_geometry(struct gc5035 *gc5035,
+				 const struct v4l2_rect *crop)
+{
+	int ret = 0;
+
+	/* Readout window: full width, the rows of the crop rectangle. */
+	cci_write(gc5035->regmap, GC5035_REG_PAGE_SELECT, GC5035_PAGE_0, &ret);
+	cci_write(gc5035->regmap, GC5035_REG_WIN_TOP,
+		  crop->top + GC5035_ROW_START_OFFSET, &ret);
+	cci_write(gc5035->regmap, GC5035_REG_WIN_LEFT, GC5035_COL_START, &ret);
+	cci_write(gc5035->regmap, GC5035_REG_WIN_HEIGHT, crop->height, &ret);
+	cci_write(gc5035->regmap, GC5035_REG_WIN_WIDTH, GC5035_WIN_WIDTH, &ret);
+
+	/* Output crop: the columns of the crop rectangle. */
+	cci_write(gc5035->regmap, GC5035_REG_PAGE_SELECT, GC5035_PAGE_1, &ret);
+	cci_write(gc5035->regmap, GC5035_REG_CROP_TOP, 0, &ret);
+	cci_write(gc5035->regmap, GC5035_REG_CROP_LEFT,
+		  crop->left + GC5035_OUT_LEFT_OFFSET, &ret);
+	cci_write(gc5035->regmap, GC5035_REG_OUT_HEIGHT, crop->height, &ret);
+	cci_write(gc5035->regmap, GC5035_REG_OUT_WIDTH, crop->width, &ret);
+	cci_write(gc5035->regmap, GC5035_REG_PAGE_SELECT, GC5035_PAGE_0, &ret);
+
+	return ret;
+}
+
+/*
+ * Binning: the vendor readout window, which starts at the first row and
+ * column of the area, and the output crop in binned coordinates.
+ */
+static int gc5035_write_geometry_bin(struct gc5035 *gc5035,
+				     const struct v4l2_rect *crop,
+				     const struct v4l2_mbus_framefmt *format)
+{
+	int ret = 0;
+
+	cci_write(gc5035->regmap, GC5035_REG_PAGE_SELECT, GC5035_PAGE_0, &ret);
+	cci_write(gc5035->regmap, GC5035_REG_WIN_TOP, GC5035_WIN_TOP_BIN, &ret);
+	cci_write(gc5035->regmap, GC5035_REG_WIN_LEFT, GC5035_WIN_LEFT_BIN,
+		  &ret);
+	cci_write(gc5035->regmap, GC5035_REG_WIN_HEIGHT, GC5035_WIN_HEIGHT_BIN,
+		  &ret);
+	cci_write(gc5035->regmap, GC5035_REG_WIN_WIDTH, GC5035_WIN_WIDTH_BIN,
+		  &ret);
+
+	cci_write(gc5035->regmap, GC5035_REG_PAGE_SELECT, GC5035_PAGE_1, &ret);
+	cci_write(gc5035->regmap, GC5035_REG_CROP_TOP, crop->top / 2, &ret);
+	cci_write(gc5035->regmap, GC5035_REG_CROP_LEFT, crop->left / 2, &ret);
+	cci_write(gc5035->regmap, GC5035_REG_OUT_HEIGHT, format->height, &ret);
+	cci_write(gc5035->regmap, GC5035_REG_OUT_WIDTH, format->width, &ret);
+	cci_write(gc5035->regmap, GC5035_REG_PAGE_SELECT, GC5035_PAGE_0, &ret);
+
+	return ret;
+}
+
+static int gc5035_enable_streams(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 u32 pad, u64 streams_mask)
+{
+	struct gc5035 *gc5035 = to_gc5035(sd);
+	const struct v4l2_mbus_framefmt *format;
+	const struct v4l2_rect *crop;
+	int ret;
+
+	ret = pm_runtime_resume_and_get(gc5035->dev);
+	if (ret < 0)
+		return ret;
+
+	ret = cci_multi_reg_write(gc5035->regmap, gc5035_regs,
+				  ARRAY_SIZE(gc5035_regs), NULL);
+	if (ret)
+		goto err_rpm_put;
+
+	crop = v4l2_subdev_state_get_crop(state, 0);
+	format = v4l2_subdev_state_get_format(state, 0);
+	if (gc5035_is_binned(crop, format)) {
+		ret = cci_multi_reg_write(gc5035->regmap, gc5035_bin_regs,
+					  ARRAY_SIZE(gc5035_bin_regs), NULL);
+		if (ret)
+			goto err_rpm_put;
+
+		ret = gc5035_write_geometry_bin(gc5035, crop, format);
+	} else {
+		ret = gc5035_write_geometry(gc5035, crop);
+	}
+	if (ret)
+		goto err_rpm_put;
+
+	ret = __v4l2_ctrl_handler_setup(&gc5035->ctrls);
+	if (ret)
+		goto err_rpm_put;
+
+	ret = cci_write(gc5035->regmap, GC5035_REG_STREAM,
+			GC5035_STREAM_ON, NULL);
+	if (ret)
+		goto err_rpm_put;
+
+	return 0;
+
+err_rpm_put:
+	pm_runtime_put_autosuspend(gc5035->dev);
+
+	return ret;
+}
+
+static int gc5035_disable_streams(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state,
+				  u32 pad, u64 streams_mask)
+{
+	struct gc5035 *gc5035 = to_gc5035(sd);
+	int ret = 0;
+
+	/* cci_write() logs errors, nothing else can be done about them. */
+	cci_write(gc5035->regmap, GC5035_REG_PAGE_SELECT, GC5035_PAGE_0, &ret);
+	cci_write(gc5035->regmap, GC5035_REG_STREAM, GC5035_STREAM_OFF, &ret);
+
+	pm_runtime_put_autosuspend(gc5035->dev);
+
+	return 0;
+}
+
+static const struct v4l2_subdev_video_ops gc5035_video_ops = {
+	.s_stream = v4l2_subdev_s_stream_helper,
+};
+
+static const struct v4l2_subdev_pad_ops gc5035_pad_ops = {
+	.enum_mbus_code = gc5035_enum_mbus_code,
+	.enum_frame_size = gc5035_enum_frame_size,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.set_fmt = gc5035_set_fmt,
+	.get_selection = gc5035_get_selection,
+	.set_selection = gc5035_set_selection,
+	.get_frame_desc = gc5035_get_frame_desc,
+	.enable_streams = gc5035_enable_streams,
+	.disable_streams = gc5035_disable_streams,
+};
+
+static const struct v4l2_subdev_ops gc5035_subdev_ops = {
+	.video = &gc5035_video_ops,
+	.pad = &gc5035_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops gc5035_internal_ops = {
+	.init_state = gc5035_init_state,
+};
+
+static int gc5035_parse_fwnode(struct gc5035 *gc5035)
+{
+	struct v4l2_fwnode_endpoint bus_cfg = {
+		.bus_type = V4L2_MBUS_CSI2_DPHY,
+	};
+	struct device *dev = gc5035->dev;
+	struct fwnode_handle *endpoint;
+	unsigned long link_freq_bitmap;
+	int ret;
+
+	endpoint = fwnode_graph_get_endpoint_by_id(dev_fwnode(dev), 0, 0,
+						   FWNODE_GRAPH_ENDPOINT_NEXT);
+	ret = v4l2_fwnode_endpoint_alloc_parse(endpoint, &bus_cfg);
+	fwnode_handle_put(endpoint);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to parse endpoint\n");
+
+	/* The register table configures the CSI-2 transmitter for 2 lanes. */
+	if (bus_cfg.bus.mipi_csi2.num_data_lanes != GC5035_DATA_LANES) {
+		ret = dev_err_probe(dev, -EINVAL,
+				    "unsupported number of data lanes %u\n",
+				    bus_cfg.bus.mipi_csi2.num_data_lanes);
+		goto done;
+	}
+
+	ret = v4l2_link_freq_to_bitmap(dev, bus_cfg.link_frequencies,
+				       bus_cfg.nr_of_link_frequencies,
+				       gc5035_link_freq_menu,
+				       ARRAY_SIZE(gc5035_link_freq_menu),
+				       &link_freq_bitmap);
+	if (ret)
+		goto done;
+
+	if (!(link_freq_bitmap & BIT(GC5035_LINK_FREQ_FULL_INDEX))) {
+		ret = dev_err_probe(dev, -EINVAL,
+				    "link frequency %lu Hz not supported\n",
+				    GC5035_LINK_FREQ);
+		goto done;
+	}
+
+	gc5035->binning = link_freq_bitmap & BIT(GC5035_LINK_FREQ_BIN_INDEX);
+
+done:
+	v4l2_fwnode_endpoint_free(&bus_cfg);
+
+	return ret;
+}
+
+static int gc5035_init_controls(struct gc5035 *gc5035)
+{
+	struct v4l2_fwnode_device_properties props;
+	struct v4l2_ctrl_handler *ctrl_hdlr;
+	s64 exposure_max;
+	int ret;
+
+	ret = v4l2_fwnode_device_parse(gc5035->dev, &props);
+	if (ret)
+		return ret;
+
+	ctrl_hdlr = &gc5035->ctrls;
+	v4l2_ctrl_handler_init(ctrl_hdlr, 9);
+
+	/* The binned mode frequency is only listed when the firmware has it. */
+	gc5035->link_freq =
+		v4l2_ctrl_new_int_menu(ctrl_hdlr, NULL, V4L2_CID_LINK_FREQ,
+				       gc5035->binning ?
+				       GC5035_LINK_FREQ_BIN_INDEX :
+				       GC5035_LINK_FREQ_FULL_INDEX,
+				       GC5035_LINK_FREQ_FULL_INDEX,
+				       gc5035_link_freq_menu);
+
+	gc5035->pixel_rate =
+		v4l2_ctrl_new_std(ctrl_hdlr, NULL, V4L2_CID_PIXEL_RATE,
+				  GC5035_PIXEL_RATE_BIN, GC5035_PIXEL_RATE, 1,
+				  GC5035_PIXEL_RATE);
+
+	/* Ranges for the default crop rectangle, see gc5035_update_ctrls(). */
+	gc5035->vblank = v4l2_ctrl_new_std(ctrl_hdlr, &gc5035_ctrl_ops,
+					   V4L2_CID_VBLANK, GC5035_VBLANK_MIN,
+					   GC5035_VBLANK_MIN +
+					   round_down(GC5035_VTS_MAX -
+						      GC5035_HEIGHT -
+						      GC5035_VBLANK_MIN,
+						      GC5035_VBLANK_STEP),
+					   GC5035_VBLANK_STEP,
+					   GC5035_VBLANK_MIN);
+
+	gc5035->hblank = v4l2_ctrl_new_std(ctrl_hdlr, NULL, V4L2_CID_HBLANK,
+					   GC5035_HTS - GC5035_WIDTH,
+					   GC5035_HTS - GC5035_WIDTH, 1,
+					   GC5035_HTS - GC5035_WIDTH);
+
+	exposure_max = GC5035_HEIGHT + GC5035_VBLANK_MIN - GC5035_EXP_MARGIN;
+	gc5035->exposure = v4l2_ctrl_new_std(ctrl_hdlr, &gc5035_ctrl_ops,
+					     V4L2_CID_EXPOSURE, GC5035_EXP_MIN,
+					     exposure_max, GC5035_EXP_STEP,
+					     GC5035_EXP_DEF);
+
+	v4l2_ctrl_new_std(ctrl_hdlr, &gc5035_ctrl_ops, V4L2_CID_ANALOGUE_GAIN,
+			  0, ARRAY_SIZE(gc5035_again_code) - 1, 1, 0);
+
+	v4l2_ctrl_new_std_menu_items(ctrl_hdlr, &gc5035_ctrl_ops,
+				     V4L2_CID_TEST_PATTERN,
+				     ARRAY_SIZE(gc5035_test_pattern_menu) - 1,
+				     0, 0, gc5035_test_pattern_menu);
+
+	v4l2_ctrl_new_fwnode_properties(ctrl_hdlr, &gc5035_ctrl_ops, &props);
+
+	if (ctrl_hdlr->error) {
+		v4l2_ctrl_handler_free(ctrl_hdlr);
+		return ctrl_hdlr->error;
+	}
+
+	gc5035->link_freq->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+	gc5035->hblank->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	gc5035->sd.ctrl_handler = ctrl_hdlr;
+
+	return 0;
+}
+
+static int gc5035_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct gc5035 *gc5035;
+	unsigned long freq;
+	int ret;
+
+	gc5035 = devm_kzalloc(dev, sizeof(*gc5035), GFP_KERNEL);
+	if (!gc5035)
+		return -ENOMEM;
+
+	gc5035->dev = dev;
+
+	v4l2_i2c_subdev_init(&gc5035->sd, client, &gc5035_subdev_ops);
+	gc5035->sd.internal_ops = &gc5035_internal_ops;
+
+	ret = gc5035_parse_fwnode(gc5035);
+	if (ret)
+		return ret;
+
+	gc5035->xclk = devm_clk_get(dev, NULL);
+	if (IS_ERR(gc5035->xclk))
+		return dev_err_probe(dev, PTR_ERR(gc5035->xclk),
+				     "failed to get clock\n");
+
+	freq = clk_get_rate(gc5035->xclk);
+	/*
+	 * J716F: the vendor runs this sensor's MCLK at 24 MHz, not the 19.2 MHz
+	 * the driver assumes. Accept either so the clock can be tested.
+	 */
+	if (freq != GC5035_XCLK_FREQ && freq != 24000000)
+		return dev_err_probe(dev, -EINVAL,
+				     "external clock %lu Hz not supported\n",
+				     freq);
+
+	gc5035->regmap = devm_cci_regmap_init_i2c(client, 8);
+	if (IS_ERR(gc5035->regmap))
+		return dev_err_probe(dev, PTR_ERR(gc5035->regmap),
+				     "failed to init CCI\n");
+
+	gc5035->reset_gpio = devm_gpiod_get_optional(dev, "reset",
+						     GPIOD_OUT_HIGH);
+	if (IS_ERR(gc5035->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(gc5035->reset_gpio),
+				     "failed to get reset GPIO\n");
+
+	gc5035->powerdown_gpio = devm_gpiod_get_optional(dev, "powerdown",
+							 GPIOD_OUT_HIGH);
+	if (IS_ERR(gc5035->powerdown_gpio))
+		return dev_err_probe(dev, PTR_ERR(gc5035->powerdown_gpio),
+				     "failed to get powerdown GPIO\n");
+
+	for (unsigned int i = 0; i < ARRAY_SIZE(gc5035_supply_name); i++)
+		gc5035->supplies[i].supply = gc5035_supply_name[i];
+
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(gc5035_supply_name),
+				      gc5035->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get regulators\n");
+
+	ret = gc5035_power_on(dev);
+	if (ret)
+		return ret;
+
+	/*
+	 * J716F: allow the chip-ID check to be skipped from the device tree.
+	 * Used to bring up a module whose address or ID is not yet known:
+	 * the power sequence stays applied so the CCI bus can be scanned.
+	 */
+	if (device_property_read_bool(dev, "skip-id-check")) {
+		dev_warn(dev, "gc5035: chip-ID check skipped (DT)\n");
+	} else {
+		ret = gc5035_identify_module(gc5035);
+		if (ret)
+			goto err_power_off;
+	}
+
+	ret = gc5035_init_controls(gc5035);
+	if (ret) {
+		dev_err_probe(dev, ret, "failed to init controls\n");
+		goto err_power_off;
+	}
+
+	gc5035->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	gc5035->pad.flags = MEDIA_PAD_FL_SOURCE;
+	gc5035->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+
+	ret = media_entity_pads_init(&gc5035->sd.entity, 1, &gc5035->pad);
+	if (ret < 0) {
+		dev_err_probe(dev, ret, "failed to init media entity\n");
+		goto err_ctrl_handler_free;
+	}
+
+	gc5035->sd.state_lock = gc5035->ctrls.lock;
+	ret = v4l2_subdev_init_finalize(&gc5035->sd);
+	if (ret < 0) {
+		dev_err_probe(dev, ret, "failed to finalize subdev\n");
+		goto err_media_entity_cleanup;
+	}
+
+	pm_runtime_set_active(dev);
+	pm_runtime_enable(dev);
+	pm_runtime_set_autosuspend_delay(dev, 1000);
+	pm_runtime_use_autosuspend(dev);
+
+	ret = v4l2_async_register_subdev_sensor(&gc5035->sd);
+	if (ret < 0) {
+		dev_err_probe(dev, ret, "failed to register subdev\n");
+		goto err_rpm;
+	}
+
+	pm_runtime_idle(dev);
+
+	return 0;
+
+err_rpm:
+	pm_runtime_disable(dev);
+	pm_runtime_dont_use_autosuspend(dev);
+	pm_runtime_set_suspended(dev);
+	v4l2_subdev_cleanup(&gc5035->sd);
+
+err_media_entity_cleanup:
+	media_entity_cleanup(&gc5035->sd.entity);
+
+err_ctrl_handler_free:
+	v4l2_ctrl_handler_free(&gc5035->ctrls);
+
+err_power_off:
+	gc5035_power_off(dev);
+
+	return ret;
+}
+
+static void gc5035_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct gc5035 *gc5035 = to_gc5035(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(&gc5035->ctrls);
+
+	pm_runtime_disable(&client->dev);
+	if (!pm_runtime_status_suspended(&client->dev)) {
+		gc5035_power_off(&client->dev);
+		pm_runtime_set_suspended(&client->dev);
+	}
+	pm_runtime_dont_use_autosuspend(&client->dev);
+}
+
+static const struct dev_pm_ops gc5035_pm_ops = {
+	RUNTIME_PM_OPS(gc5035_power_off, gc5035_power_on, NULL)
+};
+
+static const struct acpi_device_id gc5035_acpi_ids[] = {
+	{ .id = "GCTI5035" },
+	{ }
+};
+MODULE_DEVICE_TABLE(acpi, gc5035_acpi_ids);
+
+static const struct of_device_id gc5035_of_match[] = {
+	{ .compatible = "galaxycore,gc5035" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, gc5035_of_match);
+
+static struct i2c_driver gc5035_i2c_driver = {
+	.driver = {
+		.name = "gc5035",
+		.acpi_match_table = gc5035_acpi_ids,
+		.of_match_table = gc5035_of_match,
+		.pm = pm_ptr(&gc5035_pm_ops),
+	},
+	.probe = gc5035_probe,
+	.remove = gc5035_remove,
+};
+module_i2c_driver(gc5035_i2c_driver);
+
+MODULE_AUTHOR("Nicola Fiorillo <nicfio@gmail.com>");
+MODULE_DESCRIPTION("GalaxyCore GC5035 sensor driver");
+MODULE_LICENSE("GPL");
diff --git a/drivers/media/i2c/s5k4h7.c b/drivers/media/i2c/s5k4h7.c
--- /dev/null
+++ b/drivers/media/i2c/s5k4h7.c
@@ -0,0 +1,836 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Samsung S5K4H7 (ISOCELL 4H7) 8 MP image sensor driver
+ *
+ * The S5K4H7 uses 16-bit big-endian register addresses over I2C, like the
+ * OmniVision parts, and reports its chip ID at register 0x0000. Two modules
+ * are fitted to the Lenovo Xiaoxin Pad Pro 2021 (TB-J716F): an RGB one on the
+ * front and an IR one beside it.
+ *
+ * This driver implements the minimum needed to identify the sensor, put it in
+ * a known mode and stream raw Bayer frames through the Qualcomm CAMSS
+ * pipeline: power sequencing, chip-ID check, one full-resolution mode,
+ * exposure/gain controls and a 2-lane MIPI CSI-2 output.
+ */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/pm_runtime.h>
+#include <linux/regmap.h>
+#include <linux/regulator/consumer.h>
+
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-fwnode.h>
+
+/* Register access is 16-bit big-endian; values are 8/16/24 bits wide. */
+#define S5K4H7_REG_VALUE_08BIT		1
+#define S5K4H7_REG_VALUE_16BIT		2
+#define S5K4H7_REG_VALUE_24BIT		3
+
+#define S5K4H7_REG_CHIP_ID		0x0000
+#define S5K4H7_CHIP_ID_RGB		0x487b
+#define S5K4H7_CHIP_ID_IR		0x487d
+
+/*
+ * 0x0100/0x0101 form a 16-bit "mode select" register pair: 0x0100 is the
+ * high byte and 0x0101 the low byte. The reset value is 0x0100 (high 0x01,
+ * low 0x00) and the streaming bit is bit 0 of the low byte, so the stream
+ * command is a write of 0x01 to 0x0101.
+ */
+#define S5K4H7_REG_MODE_SELECT		0x0100
+#define S5K4H7_REG_MODE_SELECT_LOW	0x0101
+#define S5K4H7_MODE_STANDBY		0x00
+#define S5K4H7_MODE_STREAMING		0x01
+
+#define S5K4H7_REG_SOFTWARE_RESET	0x0103
+#define S5K4H7_SOFTWARE_RESET		0x01
+
+/* Full-resolution (3264x2448) mode, 2 data lanes, 19.2 MHz XVCLK. */
+#define S5K4H7_NATIVE_WIDTH		3264
+#define S5K4H7_NATIVE_HEIGHT		2448
+
+/* Link frequency for the 2-lane mode used by the vendor tables. */
+#define S5K4H7_LINK_FREQ_480MHZ		480000000ULL
+
+/*
+ * Pixel rate from the link frequency: double data rate, 2 lanes, 10 bits per
+ * pixel. The /10 matters: without it the value is ten times too high and the
+ * VFE clock check in camss-vfe.c fails with -EBUSY ("Failed to power up
+ * pipeline"), because the required rate exceeds what VFE1 can supply.
+ */
+static u64 s5k4h7_link_freq_to_pixel_rate(u64 f)
+{
+	f *= 2 * 4;	/* DDR * 4 data lanes */
+	do_div(f, 10);	/* 10 bits per pixel */
+
+	return f;
+}
+
+#define S5K4H7_PIXEL_RATE		s5k4h7_link_freq_to_pixel_rate(S5K4H7_LINK_FREQ_480MHZ)
+
+/* Exposure is 16 bits spread over three registers, VTS is 16 bits. */
+#define S5K4H7_REG_EXPOSURE		0x0202
+#define S5K4H7_EXPOSURE_MIN		4
+#define S5K4H7_EXPOSURE_STEP		1
+#define S5K4H7_EXPOSURE_DEFAULT		0x0400
+#define S5K4H7_REG_VTS			0x0340
+#define S5K4H7_VTS_MAX			0xffff
+#define S5K4H7_VTS_DEFAULT		0x09a0
+
+#define S5K4H7_REG_ANALOG_GAIN		0x0204
+#define S5K4H7_AGAIN_MIN		0
+#define S5K4H7_AGAIN_MAX		0x1f
+#define S5K4H7_AGAIN_DEFAULT		0x08
+
+#define S5K4H7_REG_DIGITAL_GAIN		0x020e
+#define S5K4H7_DGAIN_MIN		0
+#define S5K4H7_DGAIN_MAX		0x3f
+#define S5K4H7_DGAIN_DEFAULT		0x10
+
+static const s64 s5k4h7_link_freq_menu[] = {
+	S5K4H7_LINK_FREQ_480MHZ,
+};
+
+#define S5K4H7_REG_TEST_PATTERN		0x0600
+#define S5K4H7_TEST_PATTERN_OFF		0x0000
+
+/*
+ * Minimal bring-up sequence. The vendor module ships a 4 kB register table
+ * (com.qti.sensormodule.lce_s5k4h7rgb.bin, regSetting at 0xeb8) which this
+ * sequence is distilled from: soft reset, PLL setup for 19.2 MHz XVCLK,
+ * 2-lane MIPI output, full-resolution readout and raw10 packing.
+ */
+/*
+ * Register sequence for the 3264x2448 mode, taken verbatim from the upstream
+ * mainline V4L2 driver for this sensor (drivers/media/i2c/s5k4h7yx.c by Luca
+ * Weiss, msm8953-mainline). The large 0x30xx / 0x3Cxx block is the analogue
+ * and MIPI block setup that a hand-derived table misses - without it the
+ * sensor accepts every register write and reports streaming, but emits no
+ * CSI-2 data.
+ */
+static const struct reg_sequence s5k4h7_init_regs[] = {
+	{ 0x0100, 0x00 },
+	{ 0x0B05, 0x01 },
+	{ 0x3074, 0x06 },
+	{ 0x3075, 0x2F },
+	{ 0x308A, 0x20 },
+	{ 0x308B, 0x08 },
+	{ 0x308C, 0x0B },
+	{ 0x3081, 0x07 },
+	{ 0x307B, 0x85 },
+	{ 0x307A, 0x0A },
+	{ 0x3079, 0x0A },
+	{ 0x306E, 0x71 },
+	{ 0x306F, 0x28 },
+	{ 0x301F, 0x20 },
+	{ 0x306B, 0x9A },
+	{ 0x3091, 0x1F },
+	{ 0x30C4, 0x06 },
+	{ 0x3200, 0x09 },
+	{ 0x306A, 0x79 },
+	{ 0x30B0, 0xFF },
+	{ 0x306D, 0x08 },
+	{ 0x3080, 0x00 },
+	{ 0x3929, 0x3F },
+	{ 0x3084, 0x16 },
+	{ 0x3070, 0x0F },
+	{ 0x3B45, 0x01 },
+	{ 0x30C2, 0x05 },
+	{ 0x3069, 0x87 },
+	{ 0x3924, 0x7F },
+	{ 0x3925, 0xFD },
+	{ 0x3C08, 0xFF },
+	{ 0x3C09, 0xFF },
+	{ 0x3C31, 0xFF },
+	{ 0x3C32, 0xFF },
+	{ 0x0A02, 0x14 },
+	{ 0x0100, 0x00 },
+	{ 0x0136, 0x18 },
+	{ 0x0137, 0x00 },
+	{ 0x0305, 0x06 },
+	{ 0x0306, 0x00 },
+	{ 0x0307, 0x8C },
+	{ 0x030D, 0x06 },
+	{ 0x030E, 0x00 },
+	{ 0x030F, 0xAF },
+	{ 0x3C1F, 0x00 },
+	{ 0x3C17, 0x00 },
+	{ 0x3C1C, 0x05 },
+	{ 0x3C1D, 0x15 },
+	{ 0x0301, 0x04 },
+	{ 0x0820, 0x02 },
+	{ 0x0821, 0xBC },
+	{ 0x0822, 0x00 },
+	{ 0x0823, 0x00 },
+	{ 0x0112, 0x0A },
+	{ 0x0113, 0x0A },
+	{ 0x0114, 0x03 },
+	{ 0x3906, 0x04 },
+	{ 0x0344, 0x00 },
+	{ 0x0345, 0x08 },
+	{ 0x0346, 0x00 },
+	{ 0x0347, 0x08 },
+	{ 0x0348, 0x0C },
+	{ 0x0349, 0xC7 },
+	{ 0x034A, 0x09 },
+	{ 0x034B, 0x97 },
+	{ 0x034C, 0x0C },
+	{ 0x034D, 0xC0 },
+	{ 0x034E, 0x09 },
+	{ 0x034F, 0x90 },
+	{ 0x0900, 0x00 },
+	{ 0x0901, 0x00 },
+	{ 0x0381, 0x01 },
+	{ 0x0383, 0x01 },
+	{ 0x0385, 0x01 },
+	{ 0x0387, 0x01 },
+	{ 0x0101, 0x00 },
+	{ 0x0340, 0x09 },
+	{ 0x0341, 0xE2 },
+	{ 0x0342, 0x0E },
+	{ 0x0343, 0x68 },
+	{ 0x0200, 0x0D },
+	{ 0x0201, 0xD8 },
+	{ 0x0202, 0x02 },
+	{ 0x0203, 0x08 },
+};
+
+struct s5k4h7 {
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+	struct clk *xclk;
+	struct gpio_desc *reset_gpio;
+	struct gpio_desc *powerdown_gpio;
+
+	struct regulator *vana;
+	struct regulator *vdig;
+	struct regulator *vio;
+
+	struct v4l2_ctrl_handler ctrl_handler;
+	struct v4l2_ctrl *exposure;
+	struct v4l2_ctrl *again;
+	struct v4l2_ctrl *dgain;
+	struct v4l2_ctrl *link_freq;
+	struct v4l2_ctrl *pixel_rate;
+
+	struct mutex lock;
+	bool streaming;
+};
+
+/*
+ * 16-bit big-endian register access, matching the sensor's I2C protocol.
+ * This is the same shape as ov13b10_read_reg(): a two-message transfer with
+ * the register address in network byte order.
+ */
+static int s5k4h7_read_reg(struct s5k4h7 *sensor, u16 reg, u32 len, u32 *val)
+{
+	struct i2c_client *client = v4l2_get_subdevdata(&sensor->sd);
+	struct i2c_msg msgs[2];
+	u8 *data_be_p;
+	int ret;
+	__be32 data_be = 0;
+	__be16 reg_addr_be = cpu_to_be16(reg);
+
+	if (len > 4)
+		return -EINVAL;
+
+	data_be_p = (u8 *)&data_be;
+	/* Write register address */
+	msgs[0].addr = client->addr;
+	msgs[0].flags = 0;
+	msgs[0].len = 2;
+	msgs[0].buf = (u8 *)&reg_addr_be;
+
+	/* Read data */
+	msgs[1].addr = client->addr;
+	msgs[1].flags = I2C_M_RD;
+	msgs[1].len = len;
+	msgs[1].buf = &data_be_p[4 - len];
+
+	ret = i2c_transfer(client->adapter, msgs, ARRAY_SIZE(msgs));
+	if (ret != ARRAY_SIZE(msgs))
+		return ret < 0 ? ret : -EIO;
+
+	*val = be32_to_cpu(data_be);
+
+	return 0;
+}
+
+static int s5k4h7_write_reg(struct s5k4h7 *sensor, u16 reg, u32 len, u32 val)
+{
+	struct i2c_client *client = v4l2_get_subdevdata(&sensor->sd);
+	struct i2c_msg msg;
+	u8 buf[6];
+	__be16 reg_addr_be = cpu_to_be16(reg);
+	__be32 data_be = cpu_to_be32(val);
+	int ret;
+
+	if (len > 4 || len < 1)
+		return -EINVAL;
+
+	/* Register address, then the value's significant bytes, big-endian. */
+	memcpy(buf, &reg_addr_be, 2);
+	memcpy(&buf[2], &((u8 *)&data_be)[4 - len], len);
+
+	msg.addr = client->addr;
+	msg.flags = 0;
+	msg.len = 2 + len;
+	msg.buf = buf;
+
+	ret = i2c_transfer(client->adapter, &msg, 1);
+	if (ret != 1)
+		return ret < 0 ? ret : -EIO;
+
+	return 0;
+}
+
+static int s5k4h7_identify_module(struct s5k4h7 *sensor)
+{
+	struct i2c_client *client = v4l2_get_subdevdata(&sensor->sd);
+	u32 val;
+	int ret;
+
+	if (device_property_read_bool(&client->dev, "skip-id-check")) {
+		dev_info(&client->dev, "s5k4h7: chip-ID check skipped (DT)\n");
+		return 0;
+	}
+
+	ret = s5k4h7_read_reg(sensor, S5K4H7_REG_CHIP_ID,
+			     S5K4H7_REG_VALUE_16BIT, &val);
+	if (ret) {
+		dev_err(&client->dev, "failed to read chip id: %d\n", ret);
+		return ret;
+	}
+
+	if (val != S5K4H7_CHIP_ID_RGB && val != S5K4H7_CHIP_ID_IR) {
+		dev_err(&client->dev, "chip id mismatch: 0x%x\n", val);
+		return -EIO;
+	}
+
+	dev_info(&client->dev, "S5K4H7 detected, chip id 0x%04x\n", val);
+
+	return 0;
+}
+
+static int s5k4h7_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct s5k4h7 *sensor = container_of(sd, struct s5k4h7, sd);
+	int ret;
+
+	ret = clk_prepare_enable(sensor->xclk);
+	if (ret) {
+		dev_err(dev, "failed to enable xclk: %d\n", ret);
+		return ret;
+	}
+
+	if (sensor->vio) {
+		ret = regulator_enable(sensor->vio);
+		if (ret)
+			goto err_clk;
+	}
+
+	if (sensor->vana) {
+		ret = regulator_enable(sensor->vana);
+		if (ret)
+			goto err_vio;
+	}
+
+	if (sensor->vdig) {
+		ret = regulator_enable(sensor->vdig);
+		if (ret)
+			goto err_vana;
+	}
+
+	gpiod_set_value_cansleep(sensor->powerdown_gpio, 0);
+	gpiod_set_value_cansleep(sensor->reset_gpio, 0);
+	usleep_range(5000, 6000);
+
+	return 0;
+
+err_vana:
+	if (sensor->vana)
+		regulator_disable(sensor->vana);
+err_vio:
+	if (sensor->vio)
+		regulator_disable(sensor->vio);
+err_clk:
+	clk_disable_unprepare(sensor->xclk);
+	return ret;
+}
+
+static int s5k4h7_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct s5k4h7 *sensor = container_of(sd, struct s5k4h7, sd);
+
+	gpiod_set_value_cansleep(sensor->reset_gpio, 1);
+	gpiod_set_value_cansleep(sensor->powerdown_gpio, 1);
+	if (sensor->vdig)
+		regulator_disable(sensor->vdig);
+	if (sensor->vana)
+		regulator_disable(sensor->vana);
+	if (sensor->vio)
+		regulator_disable(sensor->vio);
+	clk_disable_unprepare(sensor->xclk);
+
+	return 0;
+}
+
+static int s5k4h7_enable_streams(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 u32 pad, u64 streams_mask)
+{
+	struct s5k4h7 *sensor = container_of(sd, struct s5k4h7, sd);
+	struct device *dev = sd->dev;
+	int ret;
+
+	ret = pm_runtime_resume_and_get(dev);
+	if (ret)
+		return ret;
+
+	/* Apply the bring-up table, then the current controls. */
+	for (unsigned int i = 0; i < ARRAY_SIZE(s5k4h7_init_regs); i++) {
+		ret = s5k4h7_write_reg(sensor, s5k4h7_init_regs[i].reg,
+				       S5K4H7_REG_VALUE_08BIT,
+				       s5k4h7_init_regs[i].def);
+		if (ret)
+			goto err_rpm;
+	}
+
+	/* The sensor needs ~7.5 ms to settle before the stream-on write. */
+	usleep_range(7400, 8000);
+
+	ret = __v4l2_ctrl_handler_setup(&sensor->ctrl_handler);
+	if (ret)
+		goto err_rpm;
+
+	ret = s5k4h7_write_reg(sensor, S5K4H7_REG_MODE_SELECT,
+			       S5K4H7_REG_VALUE_08BIT, S5K4H7_MODE_STREAMING);
+	if (ret)
+		goto err_rpm;
+
+	/* Diagnostic: read the key registers back so the log shows what the
+	 * sensor really has after the bring-up sequence. */
+	{
+		static const u16 check[] = { 0x0000, 0x0100, 0x0101, 0x0301,
+					     0x0303, 0x0305, 0x0307, 0x0309,
+					     0x030b, 0x030d, 0x030f, 0x0311,
+					     0x0340, 0x0342, 0x0112, 0x0114 };
+		for (unsigned int i = 0; i < ARRAY_SIZE(check); i++) {
+			u32 v = 0;
+			int r = s5k4h7_read_reg(sensor, check[i],
+						S5K4H7_REG_VALUE_16BIT, &v);
+			dev_info(dev, "s5k4h7: reg 0x%04x = %s0x%04x\n",
+				 check[i], r ? "(read failed) " : "", v);
+		}
+	}
+
+	sensor->streaming = true;
+
+	return 0;
+
+err_rpm:
+	pm_runtime_put_autosuspend(dev);
+	return ret;
+}
+
+static int s5k4h7_disable_streams(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state,
+				  u32 pad, u64 streams_mask)
+{
+	struct s5k4h7 *sensor = container_of(sd, struct s5k4h7, sd);
+
+	s5k4h7_write_reg(sensor, S5K4H7_REG_MODE_SELECT,
+			 S5K4H7_REG_VALUE_08BIT, S5K4H7_MODE_STANDBY);
+	sensor->streaming = false;
+	pm_runtime_put_autosuspend(sd->dev);
+
+	return 0;
+}
+
+static const struct v4l2_subdev_video_ops s5k4h7_video_ops = {
+	/*
+	 * The Qualcomm CAMSS driver starts streams through the legacy
+	 * video.s_stream op (see video_start_streaming() in camss-video.c),
+	 * not through v4l2_subdev_enable_streams(). This helper forwards
+	 * s_stream(1/0) to the pad_ops enable_streams/disable_streams
+	 * callbacks, which is where the power sequence lives.
+	 */
+	.s_stream = v4l2_subdev_s_stream_helper,
+};
+
+/*
+ * Fill the pad format for the requested state (TRY or ACTIVE) and report it
+ * back. The state is always updated through v4l2_subdev_state_get_format();
+ * writing to fmt->format only would leave TRY handling with a NULL format
+ * pointer and oops inside this function.
+ */
+static int s5k4h7_set_pad_format(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_format *fmt)
+{
+	struct v4l2_mbus_framefmt *framefmt;
+
+	framefmt = v4l2_subdev_state_get_format(state, fmt->pad);
+	if (!framefmt)
+		return -EINVAL;
+
+	framefmt->width = fmt->format.width ? fmt->format.width
+					    : S5K4H7_NATIVE_WIDTH;
+	framefmt->height = fmt->format.height ? fmt->format.height
+					      : S5K4H7_NATIVE_HEIGHT;
+	framefmt->code = fmt->format.code ? fmt->format.code
+					  : MEDIA_BUS_FMT_SGRBG10_1X10;
+	framefmt->field = V4L2_FIELD_NONE;
+	framefmt->colorspace = V4L2_COLORSPACE_RAW;
+	framefmt->ycbcr_enc = V4L2_YCBCR_ENC_601;
+	framefmt->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	framefmt->xfer_func = V4L2_XFER_FUNC_NONE;
+
+	fmt->format = *framefmt;
+
+	return 0;
+}
+
+static int s5k4h7_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state)
+{
+	struct v4l2_subdev_format fmt = {
+		.which = V4L2_SUBDEV_FORMAT_ACTIVE,
+		.pad = 0,
+		.format = {
+			.width = S5K4H7_NATIVE_WIDTH,
+			.height = S5K4H7_NATIVE_HEIGHT,
+			.code = MEDIA_BUS_FMT_SGRBG10_1X10,
+			.field = V4L2_FIELD_NONE,
+			.colorspace = V4L2_COLORSPACE_RAW,
+			.ycbcr_enc = V4L2_YCBCR_ENC_601,
+			.quantization = V4L2_QUANTIZATION_FULL_RANGE,
+			.xfer_func = V4L2_XFER_FUNC_NONE,
+		},
+	};
+
+	return s5k4h7_set_pad_format(sd, state, &fmt);
+}
+
+static int s5k4h7_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index != 0)
+		return -EINVAL;
+
+	code->code = MEDIA_BUS_FMT_SGRBG10_1X10;
+
+	return 0;
+}
+
+static int s5k4h7_enum_frame_size(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state,
+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	if (fse->index != 0)
+		return -EINVAL;
+
+	fse->min_width = S5K4H7_NATIVE_WIDTH;
+	fse->max_width = S5K4H7_NATIVE_WIDTH;
+	fse->min_height = S5K4H7_NATIVE_HEIGHT;
+	fse->max_height = S5K4H7_NATIVE_HEIGHT;
+
+	return 0;
+}
+
+static const struct v4l2_subdev_pad_ops s5k4h7_pad_ops = {
+	.set_fmt = s5k4h7_set_pad_format,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.enum_mbus_code = s5k4h7_enum_mbus_code,
+	.enum_frame_size = s5k4h7_enum_frame_size,
+	.enable_streams = s5k4h7_enable_streams,
+	.disable_streams = s5k4h7_disable_streams,
+};
+
+/*
+ * Open sub-device. v4l2_pipeline_pm_get() walks the media graph and calls
+ * this on every entity; without it the CAMSS video node fails to open with
+ * "Failed to power up pipeline: -16". It also seeds the per-file try format.
+ */
+static int s5k4h7_open(struct v4l2_subdev *sd, struct v4l2_subdev_fh *fh)
+{
+	struct v4l2_mbus_framefmt *try_fmt =
+		v4l2_subdev_state_get_format(fh->state, 0);
+
+	try_fmt->width = S5K4H7_NATIVE_WIDTH;
+	try_fmt->height = S5K4H7_NATIVE_HEIGHT;
+	try_fmt->code = MEDIA_BUS_FMT_SGRBG10_1X10;
+	try_fmt->field = V4L2_FIELD_NONE;
+	try_fmt->colorspace = V4L2_COLORSPACE_RAW;
+	try_fmt->ycbcr_enc = V4L2_YCBCR_ENC_601;
+	try_fmt->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	try_fmt->xfer_func = V4L2_XFER_FUNC_NONE;
+
+	return 0;
+}
+
+static const struct v4l2_subdev_internal_ops s5k4h7_internal_ops = {
+	.open = s5k4h7_open,
+	.init_state = s5k4h7_init_state,
+};
+
+static const struct v4l2_subdev_ops s5k4h7_subdev_ops = {
+	.video = &s5k4h7_video_ops,
+	.pad = &s5k4h7_pad_ops,
+};
+
+static const struct media_entity_operations s5k4h7_subdev_entity_ops = {
+	.link_validate = v4l2_subdev_link_validate,
+};
+
+static int s5k4h7_init_controls(struct s5k4h7 *sensor)
+{
+	struct v4l2_ctrl_handler *ctrl_hdlr = &sensor->ctrl_handler;
+	struct v4l2_fwnode_device_properties props;
+	int ret;
+
+	ret = v4l2_ctrl_handler_init(ctrl_hdlr, 8);
+	if (ret)
+		return ret;
+
+	sensor->exposure = v4l2_ctrl_new_std(ctrl_hdlr, NULL,
+					     V4L2_CID_EXPOSURE,
+					     S5K4H7_EXPOSURE_MIN,
+					     S5K4H7_VTS_DEFAULT - 4,
+					     S5K4H7_EXPOSURE_STEP,
+					     S5K4H7_EXPOSURE_DEFAULT);
+	sensor->again = v4l2_ctrl_new_std(ctrl_hdlr, NULL,
+					  V4L2_CID_ANALOGUE_GAIN,
+					  S5K4H7_AGAIN_MIN,
+					  S5K4H7_AGAIN_MAX, 1,
+					  S5K4H7_AGAIN_DEFAULT);
+	sensor->dgain = v4l2_ctrl_new_std(ctrl_hdlr, NULL,
+					  V4L2_CID_DIGITAL_GAIN,
+					  S5K4H7_DGAIN_MIN,
+					  S5K4H7_DGAIN_MAX, 1,
+					  S5K4H7_DGAIN_DEFAULT);
+
+	/*
+	 * The CAMSS CSIPHY needs the CSI-2 transmitter link frequency, which it
+	 * reads from this read-only menu control. Without it STREAMON fails with
+	 * "Cannot get CSI2 transmitter's link frequency".
+	 */
+	sensor->link_freq = v4l2_ctrl_new_int_menu(ctrl_hdlr, NULL,
+						   V4L2_CID_LINK_FREQ,
+						   ARRAY_SIZE(s5k4h7_link_freq_menu) - 1,
+						   0, s5k4h7_link_freq_menu);
+	if (sensor->link_freq)
+		sensor->link_freq->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	sensor->pixel_rate = v4l2_ctrl_new_std(ctrl_hdlr, NULL,
+					       V4L2_CID_PIXEL_RATE,
+					       0, S5K4H7_PIXEL_RATE, 1,
+					       S5K4H7_PIXEL_RATE);
+
+	if (ctrl_hdlr->error) {
+		ret = ctrl_hdlr->error;
+		v4l2_ctrl_handler_free(ctrl_hdlr);
+		return ret;
+	}
+
+	ret = v4l2_fwnode_device_parse(sensor->sd.dev, &props);
+	if (ret)
+		goto err_free;
+
+	ret = v4l2_ctrl_new_fwnode_properties(ctrl_hdlr, NULL, &props);
+	if (ret)
+		goto err_free;
+
+	sensor->sd.ctrl_handler = ctrl_hdlr;
+
+	return 0;
+
+err_free:
+	v4l2_ctrl_handler_free(ctrl_hdlr);
+	return ret;
+}
+
+static const struct of_device_id s5k4h7_of_match[] = {
+	{ .compatible = "samsung,s5k4h7" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, s5k4h7_of_match);
+
+static const struct i2c_device_id s5k4h7_id[] = {
+	{ "s5k4h7", 0 },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(i2c, s5k4h7_id);
+
+static int s5k4h7_probe(struct i2c_client *client)
+{
+	struct s5k4h7 *sensor;
+	int ret;
+
+	sensor = devm_kzalloc(&client->dev, sizeof(*sensor), GFP_KERNEL);
+	if (!sensor)
+		return -ENOMEM;
+
+	v4l2_i2c_subdev_init(&sensor->sd, client, &s5k4h7_subdev_ops);
+	sensor->sd.internal_ops = &s5k4h7_internal_ops;
+	sensor->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	sensor->sd.entity.ops = &s5k4h7_subdev_entity_ops;
+	sensor->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+
+	mutex_init(&sensor->lock);
+
+	sensor->pad.flags = MEDIA_PAD_FL_SOURCE;
+	ret = media_entity_pads_init(&sensor->sd.entity, 1, &sensor->pad);
+	if (ret)
+		return ret;
+
+	sensor->xclk = devm_clk_get_optional(&client->dev, NULL);
+	if (IS_ERR(sensor->xclk))
+		return dev_err_probe(&client->dev, PTR_ERR(sensor->xclk),
+				     "failed to get xclk\n");
+
+	/*
+	 * The vendor runs every camera MCLK at 24 MHz on this board, and the
+	 * sensor's own PLL defaults (P=4, S=6, M=175) only produce the expected
+	 * 350 MHz link frequency at that rate. The camcc mclk has a 24 MHz
+	 * entry, so ask for it explicitly: without clk_set_rate() the clock
+	 * stays at its 19.2 MHz default and the MIPI rate is wrong.
+	 */
+	/*
+	 * NOTE: asking camcc for 24 MHz (clk_set_rate) hangs the boot on this
+	 * board - that rate comes from CAM_CC_PLL2, which the display path also
+	 * uses. The MCLK therefore stays at camcc's 19.2 MHz default, and the
+	 * sensor's PLL registers must be programmed for 19.2 MHz input instead.
+	 */
+	if (sensor->xclk)
+		dev_info(&client->dev, "s5k4h7: MCLK %lu Hz\n",
+			 clk_get_rate(sensor->xclk));
+
+	sensor->reset_gpio = devm_gpiod_get_optional(&client->dev, "reset",
+						     GPIOD_OUT_HIGH);
+	if (IS_ERR(sensor->reset_gpio))
+		return dev_err_probe(&client->dev, PTR_ERR(sensor->reset_gpio),
+				     "failed to get reset gpio\n");
+
+	sensor->powerdown_gpio = devm_gpiod_get_optional(&client->dev,
+							 "powerdown",
+							 GPIOD_OUT_HIGH);
+	if (IS_ERR(sensor->powerdown_gpio))
+		return dev_err_probe(&client->dev,
+				     PTR_ERR(sensor->powerdown_gpio),
+				     "failed to get powerdown gpio\n");
+
+	sensor->vana = devm_regulator_get_optional(&client->dev, "avdd");
+	if (IS_ERR(sensor->vana)) {
+		if (PTR_ERR(sensor->vana) != -ENODEV)
+			return dev_err_probe(&client->dev, PTR_ERR(sensor->vana),
+					     "failed to get avdd\n");
+		sensor->vana = NULL;
+	}
+
+	sensor->vdig = devm_regulator_get_optional(&client->dev, "dvdd");
+	if (IS_ERR(sensor->vdig)) {
+		if (PTR_ERR(sensor->vdig) != -ENODEV)
+			return dev_err_probe(&client->dev, PTR_ERR(sensor->vdig),
+					     "failed to get dvdd\n");
+		sensor->vdig = NULL;
+	}
+
+	sensor->vio = devm_regulator_get_optional(&client->dev, "dovdd");
+	if (IS_ERR(sensor->vio)) {
+		if (PTR_ERR(sensor->vio) != -ENODEV)
+			return dev_err_probe(&client->dev, PTR_ERR(sensor->vio),
+					     "failed to get dovdd\n");
+		sensor->vio = NULL;
+	}
+
+	ret = s5k4h7_init_controls(sensor);
+	if (ret)
+		goto err_entity;
+
+	/*
+	 * The subdev state lock must be set and the state finalised before the
+	 * subdev is registered. v4l2_subdev_enable_streams() takes
+	 * sd->state_lock via v4l2_subdev_lock_and_get_active_state(); leaving
+	 * it NULL makes STREAMON oops with a NULL-pointer dereference inside
+	 * v4l2_subdev_enable_streams().
+	 */
+	sensor->sd.state_lock = sensor->ctrl_handler.lock;
+	ret = v4l2_subdev_init_finalize(&sensor->sd);
+	if (ret)
+		goto err_ctrl;
+
+	ret = s5k4h7_power_on(&client->dev);
+	if (ret)
+		goto err_ctrl;
+
+	ret = s5k4h7_identify_module(sensor);
+	if (ret)
+		goto err_power_off;
+
+	pm_runtime_set_active(&client->dev);
+	pm_runtime_enable(&client->dev);
+	if (device_property_read_bool(&client->dev, "skip-id-check")) {
+		/* Diagnostic mode: stay powered so the bus can be scanned. */
+		dev_info(&client->dev,
+			 "s5k4h7: diagnostic mode, sensor left powered\n");
+	} else {
+		pm_runtime_set_autosuspend_delay(&client->dev, 1000);
+		pm_runtime_use_autosuspend(&client->dev);
+		pm_runtime_idle(&client->dev);
+	}
+
+	ret = v4l2_async_register_subdev_sensor(&sensor->sd);
+	if (ret)
+		goto err_pm;
+
+	return 0;
+
+err_pm:
+	pm_runtime_disable(&client->dev);
+err_power_off:
+	s5k4h7_power_off(&client->dev);
+err_ctrl:
+	v4l2_ctrl_handler_free(&sensor->ctrl_handler);
+err_entity:
+	media_entity_cleanup(&sensor->sd.entity);
+	return ret;
+}
+
+static void s5k4h7_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct s5k4h7 *sensor = container_of(sd, struct s5k4h7, sd);
+
+	v4l2_async_unregister_subdev(sd);
+	v4l2_ctrl_handler_free(&sensor->ctrl_handler);
+	media_entity_cleanup(&sd->entity);
+	pm_runtime_disable(&client->dev);
+	pm_runtime_set_suspended(&client->dev);
+}
+
+static DEFINE_RUNTIME_DEV_PM_OPS(s5k4h7_pm_ops, s5k4h7_power_off,
+				 s5k4h7_power_on, NULL);
+
+static struct i2c_driver s5k4h7_i2c_driver = {
+	.driver = {
+		.name = "s5k4h7",
+		.of_match_table = s5k4h7_of_match,
+		.pm = pm_ptr(&s5k4h7_pm_ops),
+	},
+	.probe = s5k4h7_probe,
+	.remove = s5k4h7_remove,
+	.id_table = s5k4h7_id,
+};
+module_i2c_driver(s5k4h7_i2c_driver);
+
+MODULE_DESCRIPTION("Samsung S5K4H7 image sensor driver");
+MODULE_LICENSE("GPL");
diff --git a/drivers/misc/dmic_probe.c b/drivers/misc/dmic_probe.c
--- /dev/null
+++ b/drivers/misc/dmic_probe.c
@@ -0,0 +1,144 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Sample a DMIC data line to find out whether a microphone is actually
+ * driving it.
+ *
+ * The TX/VA macro register state can look perfect while the capture port
+ * delivers nothing, because the DMIC pads are inside the LPASS and the
+ * macro only routes what arrives on them. Reading the pad directly as a
+ * GPIO is the cheapest way to tell "microphone is clocking data out"
+ * apart from "pad is idle".
+ *
+ * Usage:
+ *   echo "<lpi_pin>" > /proc/dmic_probe     # returns transitions seen
+ * A silent pad gives 0 or a tiny number; a live DMIC toggles thousands of
+ * times per millisecond.
+ */
+#include <linux/module.h>
+#include <linux/proc_fs.h>
+#include <linux/seq_file.h>
+#include <linux/uaccess.h>
+#include <linux/gpio.h>
+#include <linux/delay.h>
+
+#define LPI_GPIO_BASE 719	/* gpiochip4: GPIOs 719-732 (33c0000.pinctrl) */
+
+static int last_pin = -1;
+static unsigned long last_transitions;
+
+static ssize_t dmic_probe_write(struct file *file, const char __user *ubuf,
+				size_t count, loff_t *ppos)
+{
+	char kbuf[32];
+	int pin, g, i, prev, cur;
+	unsigned long transitions = 0;
+
+	if (count >= sizeof(kbuf))
+		return -EINVAL;
+	if (copy_from_user(kbuf, ubuf, count))
+		return -EFAULT;
+	kbuf[count] = '\0';
+
+	/*
+	 * "selftest <pin>" drives the pad as a GPIO output and reads it back,
+	 * so we can tell whether a 0-transition reading means "no signal" or
+	 * "the GPIO input path is disconnected while the pin is muxed to a
+	 * peripheral function". Without this control the DMIC measurements
+	 * are not trustworthy.
+	 */
+	if (strncmp(kbuf, "selftest", 8) == 0) {
+		int sp;
+
+		if (kstrtoint(kbuf + 8, 10, &sp) || sp < 0 || sp > 13)
+			return -EINVAL;
+		g = LPI_GPIO_BASE + sp;
+		if (gpio_request(g, "dmic-selftest"))
+			return -EBUSY;
+		gpio_direction_output(g, 0);
+		prev = gpio_get_value(g);
+		transitions = 0;
+		for (i = 0; i < 20; i++) {
+			gpio_set_value(g, i & 1);
+			cur = gpio_get_value(g);
+			if (cur != prev) {
+				transitions++;
+				prev = cur;
+			}
+		}
+		gpio_direction_input(g);
+		gpio_free(g);
+		last_pin = sp;
+		last_transitions = transitions;
+		pr_info("dmic-selftest: LPI gpio%d toggled 20x, read back %lu changes\n",
+			sp, transitions);
+		return count;
+	}
+
+	if (kstrtoint(kbuf, 10, &pin) || pin < 0 || pin > 13)
+		return -EINVAL;
+
+	g = LPI_GPIO_BASE + pin;
+	if (gpio_request(g, "dmic-probe"))
+		return -EBUSY;
+
+	gpio_direction_input(g);
+	prev = gpio_get_value(g);
+
+	/* ~20 ms of sampling: a 2.4 MHz DMIC clocks ~50k bits in that time */
+	for (i = 0; i < 20000; i++) {
+		cur = gpio_get_value(g);
+		if (cur != prev) {
+			transitions++;
+			prev = cur;
+		}
+		udelay(1);
+	}
+
+	last_pin = pin;
+	last_transitions = transitions;
+	pr_info("dmic-probe: LPI gpio%d transitions=%lu\n", pin, transitions);
+
+	gpio_free(g);
+	return count;
+}
+
+static int dmic_probe_show(struct seq_file *m, void *v)
+{
+	if (last_pin < 0)
+		seq_puts(m, "no sample yet\n");
+	else
+		seq_printf(m, "lpi_gpio=%d transitions=%lu\n",
+			   last_pin, last_transitions);
+	return 0;
+}
+
+static int dmic_probe_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, dmic_probe_show, NULL);
+}
+
+static const struct proc_ops dmic_probe_ops = {
+	.proc_open    = dmic_probe_open,
+	.proc_read    = seq_read,
+	.proc_lseek   = seq_lseek,
+	.proc_release = single_release,
+	.proc_write   = dmic_probe_write,
+};
+
+static int __init dmic_probe_init(void)
+{
+	proc_create("dmic_probe", 0200, NULL, &dmic_probe_ops);
+	pr_info("dmic-probe: ready, echo <lpi_pin 0-13> > /proc/dmic_probe\n");
+	return 0;
+}
+
+static void __exit dmic_probe_exit(void)
+{
+	remove_proc_entry("dmic_probe", NULL);
+}
+
+module_init(dmic_probe_init);
+module_exit(dmic_probe_exit);
+
+MODULE_DESCRIPTION("DMIC data line activity probe for Lenovo TB-J716F");
+MODULE_LICENSE("GPL");
diff --git a/drivers/misc/goodix_fp_scan.c b/drivers/misc/goodix_fp_scan.c
--- /dev/null
+++ b/drivers/misc/goodix_fp_scan.c
@@ -0,0 +1,214 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Goodix fingerprint SPI pin scanner for the Lenovo TB-J716F.
+ *
+ * The stock firmware drives this part over a bit-banged SPI bus, but its
+ * device tree never says which TLMM pins are used (all 20 hardware SPI
+ * controllers are disabled, and there is no spi-gpio node). Rather than
+ * guess, let user space drive arbitrary (sck, mosi, miso, cs) pin
+ * combinations and look for a combination where MISO stops being a
+ * constant 1 (which is what an idle, unconnected line reads).
+ *
+ * Everything goes through raw TLMM gpio numbers so a single module can
+ * test any pin without a rebuild.
+ */
+
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/gpio.h>
+#include <linux/gpio/driver.h>
+#include <linux/gpio/machine.h>
+#include <linux/delay.h>
+#include <linux/slab.h>
+#include <linux/proc_fs.h>
+#include <linux/seq_file.h>
+#include <linux/uaccess.h>
+
+#define MAX_PINS 8
+
+struct fp_scan {
+	int sck, mosi, miso, cs;
+	int g_miso;
+	struct gpio_desc *d_sck, *d_mosi, *d_miso, *d_cs;
+	bool claimed;
+};
+
+static struct fp_scan scan;
+
+static void release_pins(void)
+{
+	if (scan.d_sck)  { gpiod_put(scan.d_sck);  scan.d_sck = NULL; }
+	if (scan.d_mosi) { gpiod_put(scan.d_mosi); scan.d_mosi = NULL; }
+	if (scan.d_miso) { gpiod_put(scan.d_miso); scan.d_miso = NULL; }
+	if (scan.d_cs)   { gpiod_put(scan.d_cs);   scan.d_cs = NULL; }
+	scan.claimed = false;
+}
+
+/*
+ * The caller passes TLMM pin numbers (0..179), but gpiolib numbers the
+ * chips globally: f100000.pinctrl is gpiochip3 and owns 538..718, so a
+ * TLMM pin N is global GPIO 538 + N. Resolve the base at runtime instead
+ * of hardcoding it.
+ */
+static int tlmm_base = -1;
+
+static int tlmm_to_global(int pin)
+{
+	return tlmm_base + pin;
+}
+
+static int claim_pins(int sck, int mosi, int miso, int cs)
+{
+	int g_sck, g_mosi, g_miso, g_cs;
+
+	release_pins();
+
+	/* TLMM pins 0..179 live on gpiochip3 = global 538..718 */
+	if (tlmm_base < 0)
+		tlmm_base = 538;
+
+	g_sck  = tlmm_to_global(sck);
+	g_mosi = tlmm_to_global(mosi);
+	g_miso = tlmm_to_global(miso);
+	g_cs   = tlmm_to_global(cs);
+
+	scan.d_sck  = gpio_to_desc(g_sck);
+	scan.d_mosi = gpio_to_desc(g_mosi);
+	scan.d_miso = gpio_to_desc(g_miso);
+	scan.d_cs   = gpio_to_desc(g_cs);
+	if (!scan.d_sck || !scan.d_mosi || !scan.d_miso || !scan.d_cs) {
+		release_pins();
+		return -ENODEV;
+	}
+	if (gpio_request(g_sck,  "fp-scan-sck") ||
+	    gpio_request(g_mosi, "fp-scan-mosi") ||
+	    gpio_request(g_miso, "fp-scan-miso") ||
+	    gpio_request(g_cs,   "fp-scan-cs")) {
+		release_pins();
+		return -EBUSY;
+	}
+	gpiod_direction_output(scan.d_sck, 0);
+	gpiod_direction_output(scan.d_mosi, 0);
+	gpiod_direction_output(scan.d_cs, 1);
+	gpiod_direction_input(scan.d_miso);
+	scan.sck = sck; scan.mosi = mosi; scan.miso = miso; scan.cs = cs;
+	scan.g_miso = g_miso;
+	scan.claimed = true;
+	return 0;
+}
+
+static inline void sck_hi(void) { gpiod_set_value(scan.d_sck, 1); ndelay(200); }
+static inline void sck_lo(void) { gpiod_set_value(scan.d_sck, 0); ndelay(200); }
+
+static u8 bb_xfer(u8 out)
+{
+	u8 in = 0;
+	int i;
+
+	for (i = 7; i >= 0; i--) {
+		gpiod_set_value(scan.d_mosi, (out >> i) & 1);
+		sck_hi();
+		in = (in << 1) | (gpiod_get_value(scan.d_miso) & 1);
+		sck_lo();
+	}
+	return in;
+}
+
+/*
+ * One Goodix transaction: assert CS, clock out a command byte plus four
+ * payload bytes, read the last five bytes back, deassert CS.
+ * Returns the bytes read.
+ */
+static int bb_transaction(u8 cmd, u8 *rx, int n)
+{
+	int i;
+
+	gpiod_set_value(scan.d_cs, 0);
+	ndelay(500);
+	bb_xfer(cmd);
+	for (i = 0; i < n; i++)
+		rx[i] = bb_xfer(0x00);
+	gpiod_set_value(scan.d_cs, 1);
+	ndelay(500);
+	return 0;
+}
+
+
+
+/* ---- procfs interface: works as soon as the module is loaded ---- */
+
+static int fp_scan_show(struct seq_file *m, void *v)
+{
+	if (!scan.claimed) {
+		seq_puts(m, "unclaimed\n");
+		return 0;
+	}
+	seq_printf(m, "sck=%d mosi=%d miso=%d cs=%d miso_level=%d\n",
+		   scan.sck, scan.mosi, scan.miso, scan.cs,
+		   gpio_get_value(scan.g_miso));
+	return 0;
+}
+
+static int fp_scan_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, fp_scan_show, NULL);
+}
+
+static ssize_t fp_scan_write(struct file *file, const char __user *ubuf,
+			     size_t count, loff_t *ppos)
+{
+	char kbuf[64];
+	int sck, mosi, miso, cs, ret;
+	u8 rx[5];
+
+	if (count >= sizeof(kbuf))
+		return -EINVAL;
+	if (copy_from_user(kbuf, ubuf, count))
+		return -EFAULT;
+	kbuf[count] = '\0';
+
+	/* "release" drops the pins; anything else is "sck mosi miso cs" */
+	if (sysfs_streq(kbuf, "release")) {
+		release_pins();
+		return count;
+	}
+
+	if (sscanf(kbuf, "%d %d %d %d", &sck, &mosi, &miso, &cs) != 4)
+		return -EINVAL;
+
+	ret = claim_pins(sck, mosi, miso, cs);
+	if (ret)
+		return ret;
+
+	bb_transaction(0xA8, rx, 5);
+	pr_info("fp-scan: sck=%d mosi=%d miso=%d cs=%d -> %02x %02x %02x %02x %02x\n",
+		sck, mosi, miso, cs, rx[0], rx[1], rx[2], rx[3], rx[4]);
+	return count;
+}
+
+static const struct proc_ops fp_scan_proc_ops = {
+	.proc_open    = fp_scan_open,
+	.proc_read    = seq_read,
+	.proc_lseek   = seq_lseek,
+	.proc_release = single_release,
+	.proc_write   = fp_scan_write,
+};
+
+static int __init fp_scan_init(void)
+{
+	proc_create("fp_scan", 0200, NULL, &fp_scan_proc_ops);
+	pr_info("fp-scan: ready, use /proc/fp_scan\n");
+	return 0;
+}
+
+static void __exit fp_scan_exit(void)
+{
+	remove_proc_entry("fp_scan", NULL);
+	release_pins();
+}
+
+module_init(fp_scan_init);
+module_exit(fp_scan_exit);
+
+MODULE_DESCRIPTION("Goodix fingerprint SPI pin scanner for Lenovo TB-J716F");
+MODULE_LICENSE("GPL");
diff --git a/drivers/misc/goodix_fp_test.c b/drivers/misc/goodix_fp_test.c
--- /dev/null
+++ b/drivers/misc/goodix_fp_test.c
@@ -0,0 +1,218 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Minimal Goodix fingerprint bring-up helper for the Lenovo TB-J716F.
+ *
+ * The stock kernel drives this part through its own "gf_spi" driver, which
+ * is not in mainline. Before writing a full SPI driver we need to know
+ * whether the hardware comes alive at all: power the rail, release reset,
+ * and watch the IRQ line. That is all this module does - it exposes nothing
+ * but a few sysfs attributes for poking the lines from user space.
+ */
+
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/gpio/consumer.h>
+#include <linux/regulator/consumer.h>
+#include <linux/interrupt.h>
+#include <linux/delay.h>
+#include <linux/of.h>
+
+struct goodix_fp {
+	struct device *dev;
+	struct regulator *vdd;
+	struct gpio_desc *irq;
+	struct gpio_desc *reset;
+	struct gpio_desc *envdd;
+	int irq_num;
+	atomic_t irq_count;
+};
+
+static irqreturn_t goodix_fp_irq(int irq, void *data)
+{
+	struct goodix_fp *fp = data;
+
+	atomic_inc(&fp->irq_count);
+	dev_info(fp->dev, "IRQ fired (total %d)\n",
+		 atomic_read(&fp->irq_count));
+	return IRQ_HANDLED;
+}
+
+static ssize_t state_show(struct device *dev, struct device_attribute *attr,
+			  char *buf)
+{
+	struct goodix_fp *fp = dev_get_drvdata(dev);
+
+	return sysfs_emit(buf,
+		"vdd_enabled=%d\n"
+		"envdd=%d\n"
+		"reset=%d\n"
+		"irq_level=%d\n"
+		"irq_count=%d\n",
+		regulator_is_enabled(fp->vdd),
+		gpiod_get_value_cansleep(fp->envdd),
+		gpiod_get_value_cansleep(fp->reset),
+		gpiod_get_value_cansleep(fp->irq),
+		atomic_read(&fp->irq_count));
+}
+static DEVICE_ATTR_RO(state);
+
+static ssize_t reset_store(struct device *dev, struct device_attribute *attr,
+			   const char *buf, size_t count)
+{
+	struct goodix_fp *fp = dev_get_drvdata(dev);
+	int val, ret;
+
+	ret = kstrtoint(buf, 0, &val);
+	if (ret)
+		return ret;
+
+	gpiod_set_value_cansleep(fp->reset, !!val);
+	return count;
+}
+static DEVICE_ATTR_WO(reset);
+
+static ssize_t pulse_store(struct device *dev, struct device_attribute *attr,
+			   const char *buf, size_t count)
+{
+	struct goodix_fp *fp = dev_get_drvdata(dev);
+
+	/* Drive the vendor's power-up sequence: reset low, wait, reset high. */
+	gpiod_set_value_cansleep(fp->reset, 0);
+	msleep(20);
+	gpiod_set_value_cansleep(fp->reset, 1);
+	msleep(50);
+
+	dev_info(dev, "reset pulsed, irq_level=%d\n",
+		 gpiod_get_value_cansleep(fp->irq));
+	return count;
+}
+static DEVICE_ATTR_WO(pulse);
+
+static struct attribute *goodix_fp_attrs[] = {
+	&dev_attr_state.attr,
+	&dev_attr_reset.attr,
+	&dev_attr_pulse.attr,
+	NULL,
+};
+ATTRIBUTE_GROUPS(goodix_fp);
+
+static int goodix_fp_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct goodix_fp *fp;
+	int ret;
+
+	fp = devm_kzalloc(dev, sizeof(*fp), GFP_KERNEL);
+	if (!fp)
+		return -ENOMEM;
+	fp->dev = dev;
+	platform_set_drvdata(pdev, fp);
+
+	fp->vdd = devm_regulator_get(dev, "vdd");
+	if (IS_ERR(fp->vdd))
+		return dev_err_probe(dev, PTR_ERR(fp->vdd),
+				     "no vdd supply\n");
+
+	ret = regulator_enable(fp->vdd);
+	if (ret)
+		return dev_err_probe(dev, ret, "cannot enable vdd\n");
+
+	/*
+	 * The board tree uses the vendor's property names verbatim -
+	 * fp-gpio-envdd / fp-gpio-reset / fp-gpio-irq - not the
+	 * <name>-gpios form gpiod_get() expects, so resolve them by name
+	 * with the con_id-less variant and let the DT lookup do the work.
+	 */
+	/*
+	 * Power-up sequence: hold envdd low, then raise it, then release
+	 * reset. The vendor gf_spi driver does the same - without the low
+	 * phase the MCU never leaves its power-on hold and never raises
+	 * INT, which is exactly what we observe (irq_count stays 0 even
+	 * after a reset pulse).
+	 */
+	fp->envdd = devm_gpiod_get(dev, "fp-envdd", GPIOD_OUT_LOW);
+	if (IS_ERR(fp->envdd)) {
+		ret = PTR_ERR(fp->envdd);
+		dev_err(dev, "envdd gpio: %d\n", ret);
+		goto err_vdd;
+	}
+	msleep(10);
+	gpiod_set_value_cansleep(fp->envdd, 1);
+	msleep(50);
+
+	fp->reset = devm_gpiod_get(dev, "fp-reset", GPIOD_OUT_LOW);
+	if (IS_ERR(fp->reset)) {
+		ret = PTR_ERR(fp->reset);
+		dev_err(dev, "reset gpio: %d\n", ret);
+		goto err_vdd;
+	}
+
+	fp->irq = devm_gpiod_get(dev, "fp-irq", GPIOD_IN);
+	if (IS_ERR(fp->irq)) {
+		ret = PTR_ERR(fp->irq);
+		dev_err(dev, "irq gpio: %d\n", ret);
+		goto err_vdd;
+	}
+
+	msleep(20);
+	gpiod_set_value_cansleep(fp->reset, 1);
+	msleep(50);
+
+	fp->irq_num = gpiod_to_irq(fp->irq);
+	if (fp->irq_num < 0) {
+		ret = fp->irq_num;
+		goto err_vdd;
+	}
+
+	/*
+	 * Level-low caused an interrupt storm (152k events before we could
+	 * even look at them): the sensor evidently idles with its INT line
+	 * low while it has nothing to say, so a level trigger re-fires as
+	 * fast as the kernel can run the handler. Use falling-edge instead -
+	 * that is also what the vendor gf_spi driver ends up programming.
+	 */
+	ret = devm_request_threaded_irq(dev, fp->irq_num, NULL,
+					goodix_fp_irq,
+					IRQF_TRIGGER_FALLING | IRQF_ONESHOT,
+					"goodix-fp", fp);
+	if (ret)
+		goto err_vdd;
+
+	dev_info(dev, "ready: irq=%d vdd=%d envdd=%d reset=%d level=%d\n",
+		 fp->irq_num, regulator_is_enabled(fp->vdd),
+		 gpiod_get_value_cansleep(fp->envdd),
+		 gpiod_get_value_cansleep(fp->reset),
+		 gpiod_get_value_cansleep(fp->irq));
+	return 0;
+
+err_vdd:
+	regulator_disable(fp->vdd);
+	return ret;
+}
+
+static void goodix_fp_remove(struct platform_device *pdev)
+{
+	struct goodix_fp *fp = platform_get_drvdata(pdev);
+
+	regulator_disable(fp->vdd);
+}
+
+static const struct of_device_id goodix_fp_of_match[] = {
+	{ .compatible = "goodix,fingerprint" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, goodix_fp_of_match);
+
+static struct platform_driver goodix_fp_driver = {
+	.probe = goodix_fp_probe,
+	.remove = goodix_fp_remove,
+	.driver = {
+		.name = "goodix-fp",
+		.of_match_table = goodix_fp_of_match,
+		.dev_groups = goodix_fp_groups,
+	},
+};
+module_platform_driver(goodix_fp_driver);
+
+MODULE_DESCRIPTION("Goodix fingerprint bring-up helper (Lenovo TB-J716F)");
+MODULE_LICENSE("GPL");
diff --git a/drivers/tee/qseecom/Kconfig b/drivers/tee/qseecom/Kconfig
--- /dev/null
+++ b/drivers/tee/qseecom/Kconfig
@@ -0,0 +1,28 @@
+# SPDX-License-Identifier: GPL-2.0-only
+# Qualcomm QSEECOM TEE driver
+config TEE_QSEECOM
+	tristate "Qualcomm QSEECOM TEE driver"
+	depends on QCOM_QSEECOM
+	depends on !CPU_BIG_ENDIAN
+	depends on QCOM_MDT_LOADER
+	help
+	  This exposes QSEE applications reached over the legacy QSEECOM
+	  interface through the TEE subsystem, so that user space can open a
+	  session to a trusted application and invoke commands in it.
+
+	  This is the command-based Qualcomm interface, as distinct from the
+	  object-based smcinvoke interface served by the QCOMTEE driver. The
+	  two are not alternative routes to the same applications: a trusted
+	  application is built against one or the other, so what a system needs
+	  is decided by the applications in its firmware rather than by the age
+	  of its SoC. Platforms offering both interfaces are common, and may
+	  still carry applications that answer only over QSEECOM.
+
+	  Say Y if the firmware carries such applications. See
+	  Documentation/tee/qseecom.rst.
+
+	  Note that the driver cannot validate what a command means, because it
+	  does not know any application's payload format: anyone who can open
+	  the client device may send arbitrary commands to any loaded trusted
+	  application. Restrict access to the device nodes accordingly. See
+	  Documentation/tee/qseecom.rst.
