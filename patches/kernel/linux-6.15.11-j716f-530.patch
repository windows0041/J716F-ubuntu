+
+/*
+ * Display: 2560x1600 AMOLED driven by a Raydium RM69380 over *two* DSI links
+ * (each 1280x1600) in command mode. Mainline has a driver for exactly this
+ * panel (panel-raydium-rm69380.c, compatible lenovo,j716f-edo-rm69380), whose
+ * binding requires vddio, avdd and reset-gpios.
+ *
+ * HISTORY NOTE: the earlier claim that "without these nodes nothing drives
+ * the panel" turned out to be WRONG -- see the DISPLAY POLICY comment at the
+ * end of this file. With no mdss nodes the bootloader's own display pipeline
+ * keeps scanning out the simple-framebuffer, and fbcon output IS visible.
+ * These bring-up nodes are kept for reference; they are disabled below.
+ *
+ * Dual-DSI wiring follows sm8250-xiaomi-elish-common.dtsi, the reference for a
+ * working dual-DSI panel on this SoC. Values specific to the j716f panel
+ * (reset gpio, supplies, lane count, phy type) come from the device's own
+ * vendor dtbo.
+ */
+&mdss {
+	status = "okay";
+};
+
+&mdss_dsi0 {
+	vdda-supply = <&vreg_l9a_1p2>;
+	qcom,dual-dsi-mode;
+	qcom,sync-dual-dsi;
+	qcom,master-dsi;
+	status = "okay";
+
+	/*
+	 * This panel is driven in command mode: rm69380 sets
+	 * MIPI_DSI_MODE_VIDEO_BURST without MIPI_DSI_MODE_VIDEO, and
+	 * msm_dsi_is_cmd_mode() tests exactly that bit, so the DPU uses its
+	 * command-mode encoder (dpu_encoder_phys_cmd). That encoder paces
+	 * itself off the panel's TE (tearing effect) signal and waits for a
+	 * pingpong-done IRQ per kickoff; with no TE wired up it times out
+	 * forever ("failed wait_for_idle ... ret:-110") and nothing is ever
+	 * scanned out.
+	 *
+	 * The vendor tree routes TE to TLMM gpio66 (qcom,platform-te-gpio =
+	 * <&tlmm 0x42 0>), and gpio66 is one of the five SM8250 pins the TLMM
+	 * can mux to mdp_vsync. Note the pinctrl lives on the DSI *controller*
+	 * node, not on the panel child: msm's DSI host applies it through
+	 * pinctrl_pm_select_default_state(&msm_host->pdev->dev), which is the
+	 * controller device. This mirrors the one mainline command-mode DSI
+	 * panel (jdi,fhd-r63452 on msm8996-xiaomi-*).
+	 */
+	pinctrl-names = "default", "sleep";
+	pinctrl-0 = <&panel_te_active>;
+	pinctrl-1 = <&panel_te_suspend>;
+
+	panel@0 {
+		compatible = "lenovo,j716f-edo-rm69380", "raydium,rm69380";
+		reg = <0>;
+
+		vddio-supply = <&vreg_l14a_1p88>;
+		avdd-supply = <&panel_avdd>;
+
+		/* vendor: qcom,platform-reset-gpio = <&tlmm 0x4b ...> (pin 75) */
+		reset-gpios = <&tlmm 75 GPIO_ACTIVE_LOW>;
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			port@0 {
+				reg = <0>;
+
+				panel_in_0: endpoint {
+					remote-endpoint = <&mdss_dsi0_out>;
+				};
+			};
+
+			port@1 {
+				reg = <1>;
+
+				panel_in_1: endpoint {
+					remote-endpoint = <&mdss_dsi1_out>;
+				};
+			};
+		};
+	};
+};
+
+&mdss_dsi0_out {
+	/* vendor rm69380 node enables lane-0..3, i.e. 4 D-PHY lanes per link */
+	data-lanes = <0 1 2 3>;
+	remote-endpoint = <&panel_in_0>;
+};
+
+&mdss_dsi0_phy {
+	vdds-supply = <&vreg_l5a_0p88>;
+	/* vendor phy-timings start with 0x00 == D-PHY (CPHY ones start 0x01/0x03) */
+	phy-type = <PHY_TYPE_DPHY>;
+	status = "okay";
+};
+
+&mdss_dsi1 {
+	vdda-supply = <&vreg_l9a_1p2>;
+	qcom,dual-dsi-mode;
+	qcom,sync-dual-dsi;
+	/* DSI1 is the slave, so it takes DSI0's PHY clocks */
+	assigned-clock-parents = <&mdss_dsi0_phy 0>, <&mdss_dsi0_phy 1>;
+	status = "okay";
+};
+
+&mdss_dsi1_out {
+	data-lanes = <0 1 2 3>;
+	remote-endpoint = <&panel_in_1>;
+};
+
+&mdss_dsi1_phy {
+	vdds-supply = <&vreg_l5a_0p88>;
+	phy-type = <PHY_TYPE_DPHY>;
+	status = "okay";
+};
+
+/*
+ * DISPLAY POLICY (2026-10-13): the nodes above are DISABLED on this build;
+ * the panel is driven by the bootloader's display pipeline instead.
+ *
+ * Measured evidence, this device:
+ *
+ *  - The v6.2 port (no mdss nodes at all) shows a live, scrolling fbcon
+ *    console on the panel. ABL leaves its own DPU + both DSI links running,
+ *    and clk_ignore_unused / pd_ignore_unused on the cmdline keep them
+ *    clocked, so ABL's scanout keeps fetching every frame fbcon writes into
+ *    the simple-framebuffer region at 0x9c000000. That is the "display
+ *    works" state: the kernel draws, the bootloader's hardware scans out.
+ *
+ *  - With the nodes above enabled (v6.15 + panel-raydium-rm69380), the
+ *    kernel resets the panel and takes over both DSI links. The left half
+ *    streams (DSI0/master), the right half stays black (DSI1/slave PHY is
+ *    fed from the master's PLL, but its post-divider/ready state never
+ *    matches -- see PORTING-NOTES.md), and the fbcon path is gone because
+ *    simple-framebuffer no longer owns the display.
+ *
+ *  - The panel is dual-DSI command mode without DSC; no mainline board uses
+ *    that combination, and the upstream author's own dsi-experiments branch
+ *    (sm8250-mainline/linux, 2023) never got past "can I get half of the
+ *    panel working?" either.
+ *
+ * So until a real dual-DSI command-mode fix exists in the DPU, these nodes
+ * stay off. Flip every status below back to "okay" to restore the DPU
+ * bring-up build; all the kernel-side instrumentation (j716f pr_info lines,
+ * the slave CLK_CFG0 divider sync in dsi_phy_7nm.c, the dsi_host.c
+ * reset/FIFO fixes) is still in the tree and dormant.
+ */
+&mdss {
+	status = "okay";
+};
+
+&mdss_dsi0 {
+	status = "okay";
+};
+
+&mdss_dsi0_phy {
+	status = "okay";
+};
+
+&mdss_dsi1 {
+	status = "okay";
+};
+
+&mdss_dsi1_phy {
+	status = "okay";
+};
diff --git a/drivers/i2c/i2c-scan-debug.c b/drivers/i2c/i2c-scan-debug.c
--- /dev/null
+++ b/drivers/i2c/i2c-scan-debug.c
@@ -0,0 +1,32 @@
+// SPDX-License-Identifier: GPL-2.0
+/* j716f bring-up debug: scan every registered I2C adapter once, log ACKs. */
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/init.h>
+
+static int scan_adapter(struct i2c_adapter *adap, void *data)
+{
+	struct device *dev = data;
+	char b = 0;
+	int addr;
+
+	for (addr = 0x03; addr < 0x78; addr++) {
+		struct i2c_msg m = { .addr = addr, .flags = 0, .len = 1, .buf = &b };
+		int rc = i2c_transfer(adap, &m, 1);
+		if (rc == 1)
+			dev_info(dev, "i2c-scan: %s (bus %d) ACK 0x%02x\n",
+				 adap->name, i2c_adapter_id(adap), addr);
+	}
+	return 0;
+}
+
+static int __init i2c_scan_init(void)
+{
+	struct device *dev = bus_to_dev? NULL : NULL;
+	/* iterate adapters via bus_find */
+	pr_info("i2c-scan: starting\n");
+	i2c_for_each_dev(NULL, NULL);
+	return 0;
+}
+device_initcall(i2c_scan_init);
+MODULE_LICENSE("GPL");
