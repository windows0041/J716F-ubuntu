+	status = __qcom_scm_qseecom_call(&desc, &res);
+	if (!status && res.result != QSEECOM_RESULT_SUCCESS)
+		status = -EIO;
+	if (!status)
+		list_add_tail(&listener->node, &qcom_scm_qseecom_listeners);
+
+	mutex_unlock(&qcom_scm_qseecom_call_lock);
+
