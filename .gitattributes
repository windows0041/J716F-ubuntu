* text=auto
*.sh text eol=lf
*.py text eol=lf
*.c text eol=lf
*.h text eol=lf
*.patch text eol=lf
*.md text eol=lf
*.cmd text eol=crlf
# Patch context and upstream license text must remain verbatim.
*.patch -whitespace
LICENSES/** -whitespace
# Preserve the verified upstream source snapshot byte-for-byte.
/kernel/linux-7.4-rc2/** -text -filter
