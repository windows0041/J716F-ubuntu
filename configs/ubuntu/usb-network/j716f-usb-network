#!/bin/sh
set -eu
gadget=/sys/kernel/config/usb_gadget/j716f_diag
controller=/sys/class/udc/a600000.usb
if [ -d "$controller" ] && [ -e "$gadget/UDC" ] && [ -z "$(cat "$gadget/UDC")" ]; then
    echo a600000.usb > "$gadget/UDC"
fi
for interface in /sys/class/net/*; do
    [ "$(cat "$interface/address")" = 02:1a:11:00:00:01 ] || continue
    interface=${interface##*/}
    ip link set "$interface" up
    ip address replace 172.16.30.1/25 dev "$interface"
    sed "s/^interface .*/interface $interface/" /etc/j716f-usb-udhcpd.conf > /run/j716f-usb-udhcpd.conf
    exec /usr/bin/busybox-static udhcpd -f /run/j716f-usb-udhcpd.conf
done
exit 1
