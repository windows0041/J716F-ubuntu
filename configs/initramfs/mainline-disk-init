#!/bin/sh
# Mount the installed Ubuntu filesystem.
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
mount -t proc none /proc
mount -t sysfs none /sys
mount -t devtmpfs none /dev
mkdir -p /dev/pts /run /sys/kernel/config
mount -t devpts none /dev/pts
mount -t tmpfs none /run
# Show boot messages only when explicitly requested for recovery.
case " $(cat /proc/cmdline) " in
    *" j716f.boot_verbose=1 "*) ;;
    *) exec >/dev/null 2>&1 ;;
esac
mount -t configfs none /sys/kernel/config
# Expose the previous boot console without modifying persistent records.
mkdir -p /sys/fs/pstore
mount -t pstore -o ro pstore /sys/fs/pstore 2>/dev/null || true

/bin/busybox insmod /bin/nb7vpq904m.ko || echo "USB 3 redriver driver failed to load"

G=/sys/kernel/config/usb_gadget/j716f_diag
mkdir -p "$G"
if [ -d "$G" ]; then
    echo 0x1d6b > "$G/idVendor"
    echo 0x0104 > "$G/idProduct"
    # Keep the USB device identity stable across kernel versions.
    echo 0x0100 > "$G/bcdDevice"
    echo 0xEF > "$G/bDeviceClass"
    echo 0x02 > "$G/bDeviceSubClass"
    echo 0x01 > "$G/bDeviceProtocol"
    mkdir -p "$G/strings/0x409" "$G/configs/c.1/strings/0x409"
    echo J716F > "$G/strings/0x409/manufacturer"
    echo "Ubuntu USB network" > "$G/strings/0x409/product"
    echo j716f-diag > "$G/strings/0x409/serialnumber"
    echo "USB network" > "$G/configs/c.1/strings/0x409/configuration"
    echo 250 > "$G/configs/c.1/MaxPower"
    for function in rndis ecm; do
        if mkdir -p "$G/functions/$function.usb0"; then
            echo 02:1a:11:00:00:01 > "$G/functions/$function.usb0/dev_addr"
            echo 02:1a:11:00:00:02 > "$G/functions/$function.usb0/host_addr"
            if [ "$function" = rndis ]; then
                # Match the built-in Windows rndiscmp.inf NDIS 6 driver.
                echo 0xEF > "$G/functions/rndis.usb0/class"
                echo 0x04 > "$G/functions/rndis.usb0/subclass"
                echo 0x01 > "$G/functions/rndis.usb0/protocol"
                echo RNDIS > "$G/functions/rndis.usb0/os_desc/interface.rndis/compatible_id"
                echo 5162001 > "$G/functions/rndis.usb0/os_desc/interface.rndis/sub_compatible_id"
                echo 1 > "$G/os_desc/use"
                echo 0xcd > "$G/os_desc/b_vendor_code"
                echo MSFT100 > "$G/os_desc/qw_sign"
                ln -s "$G/configs/c.1" "$G/os_desc/"
            fi
            ln -s "$G/functions/$function.usb0" "$G/configs/c.1/"
            break
        fi
    done
    attempts=0
    while [ "$attempts" -lt 8 ]; do
        controller=""
        for node in /sys/class/udc/*; do
            [ ! -e "$node" ] || { controller=${node##*/}; break; }
        done
        if [ -n "$controller" ]; then
            echo "$controller" > "$G/UDC"
            echo "USB gadget bound: $controller"
            break
        fi
        attempts=$((attempts + 1))
        sleep 0.5
    done
fi

if /bin/mainline-mount-disk-root; then
    exec /bin/busybox switch_root -c /dev/console /newroot /sbin/init
fi
echo "Ubuntu root filesystem could not be mounted."
setsid cttyhack /bin/sh </dev/console >/dev/console 2>&1 &
while :; do sleep 60; done
