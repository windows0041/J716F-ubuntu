[Unit]
Description=IIO Sensor Proxy with J716F ambient light support
Requires=j716f-sensor-rpc.service
After=j716f-sensor-rpc.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=dbus
BusName=net.hadess.SensorProxy
ExecStart=/opt/j716f-sensors/libexec/iio-sensor-proxy
ProtectSystem=strict
ProtectControlGroups=true
ProtectHome=true
ProtectKernelModules=true
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX AF_LOCAL AF_NETLINK AF_QIPCRTR
MemoryDenyWriteExecute=true
RestrictRealtime=true

[Install]
WantedBy=multi-user.target
