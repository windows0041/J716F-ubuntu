[Unit]
Description=Temporary J716F SLPI startup stability observation
Requires=j716f-sensors-remoteproc.service
After=j716f-sensors-remoteproc.service
Before=j716f-sensor-rpc.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/j716f-sensors/libexec/observe-cold-stability.py
RuntimeMaxSec=650
UMask=0077

[Install]
WantedBy=multi-user.target
