 static void
+dispatch_rotated_dirty(ScreenPtr screen)
+{
+    ScrnInfoPtr scrn = xf86ScreenToScrn(screen);
+    modesettingPtr ms = modesettingPTR(scrn);
+    xf86CrtcConfigPtr config = XF86_CRTC_CONFIG_PTR(scrn);
+    int c;
+
+    for (c = 0; c < config->num_crtc; c++) {
+        xf86CrtcPtr crtc = config->crtc[c];
+        drmmode_crtc_private_ptr priv = crtc->driver_private;
+        int ret;
+
+        if (!crtc->enabled || !crtc->rotatedPixmap || !priv ||
+            !priv->rotate_fb_id || !priv->rotate_damage ||
+            !RegionNotEmpty(DamageRegion(priv->rotate_damage)))
+            continue;
+
+#ifdef GLAMOR_HAS_GBM
+        /* Submit the shadow draw before DIRTYFB's implicit fence wait. */
+        if (ms->drmmode.glamor)
+            ms->glamor.block_handler(screen);
+#endif
+        ret = dispatch_dirty_region(scrn, crtc->rotatedPixmap,
+                                    priv->rotate_damage, priv->rotate_fb_id);
+        if (!ret && !priv->rotate_dirty_logged) {
+            xf86DrvMsg(scrn->scrnIndex, X_INFO,
+                       "J716F transformed scanout dirty updates active: fb=%u\n",
+                       priv->rotate_fb_id);
+            priv->rotate_dirty_logged = TRUE;
+        } else if (ret && !priv->rotate_dirty_warned) {
+            xf86DrvMsg(scrn->scrnIndex, X_WARNING,
+                       "J716F transformed scanout DIRTYFB failed: %d\n", ret);
+            priv->rotate_dirty_warned = TRUE;
+        }
+    }
+}
