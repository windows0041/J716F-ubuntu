#!/usr/bin/env python3
import json
import os
import subprocess
import sys

# Never run face recognition over SSH / remote login
if os.environ.get("PAM_RHOST") or os.environ.get("SSH_CONNECTION") or os.environ.get("SSH_TTY"):
    sys.exit(1)

user = os.environ.get("PAM_USER", "").strip()
service = os.environ.get("PAM_SERVICE", "").strip()
if not user or user == "root":
    sys.exit(1)

safe = "".join(c for c in user if c.isalnum() or c in "._-")
db = f"/var/lib/j716f-face/{safe}.json"
if not os.path.exists(db):
    sys.exit(1)

try:
    with open(db, "r") as f:
        entries = json.load(f)
    if not entries:
        sys.exit(1)
except Exception:
    sys.exit(1)

conf = {"allow_login": True, "allow_sudo": True}
try:
    with open("/etc/j716f-face.conf", "r") as f:
        conf.update(json.load(f))
except Exception:
    pass

if service == "sudo" and not conf.get("allow_sudo", True):
    sys.exit(1)
if service.startswith("gdm") and not conf.get("allow_login", True):
    sys.exit(1)

try:
    res = subprocess.run(
        ["/usr/local/bin/j716f-face-cli", "verify", user],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        timeout=7,
    )
    sys.exit(0 if res.returncode == 0 else 1)
except Exception:
    sys.exit(1)
